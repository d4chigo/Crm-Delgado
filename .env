# ==============================================
# CRM INMOBILIARIO - Variables de Entorno (PRODUCCIÓN)
# ==============================================
# INSTRUCCIONES:
# 1. Copia este archivo como .env en la raíz del proyecto
# 2. Cambia TODAS las contraseñas y tokens por valores seguros
# 3. Genera un JWT_SECRET único: openssl rand -hex 32
# 4. NO subas el archivo .env a Git (ya está en .gitignore)

# ==============================================
# AMBIENTE
# ==============================================
NODE_ENV=development

# ==============================================
# BASE DE DATOS MYSQL
# ==============================================
# ⚠️ CAMBIAR ESTAS CONTRASEÑAS EN PRODUCCIÓN
MYSQL_ROOT_PASSWORD=crm_pass_root_2025
MYSQL_DATABASE=crm_delgado
MYSQL_USER=crm_user
MYSQL_PASSWORD=crm_pass_dev_2025

# URL de conexión para Prisma (actualizar con la contraseña correcta)
DATABASE_URL=mysql://crm_user:crm_pass_dev_2025@host.docker.internal:3306/crm_delgado

# ==============================================
# AUTENTICACIÓN Y SEGURIDAD
# ==============================================
# ⚠️ GENERAR JWT_SECRET ÚNICO: openssl rand -hex 32
JWT_SECRET=tu_jwt_secret_super_seguro_aqui_2024
JWT_EXPIRES_IN=24h

# Bcrypt - Rounds para hash de contraseñas
BCRYPT_ROUNDS=10

# ==============================================
# API EXTERNA - DNI PERÚ
# ==============================================
# Obtén tu token gratis en: https://apis.net.pe/
# ⚠️ Reemplazar con tu propio token
DNI_API_TOKEN=sk_11108.d06Mtx0zZcxUntWg3w3Gd0aKWMK6rFUC

# ==============================================
# CORS Y URLS
# ==============================================
# ⚠️ Cambiar a tu dominio en producción
CORS_ORIGIN=http://localhost:3000
CORS_EXTRA_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
CRM_API_BASE=http://backend:5000/api
DEV_ADMIN_TOKEN=dev-admin-2025-token
NEXT_PUBLIC_DEV_ADMIN_TOKEN=dev-admin-2025-token

# ==============================================
# PUERTOS (Opcional - cambiar si hay conflictos)
# ==============================================
MYSQL_PORT=3306
BACKEND_PORT=5000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
ADMINER_PORT=8080

# ==============================================
# ADMINER (Gestor de Base de Datos)
# ==============================================
# ⚠️ DESACTIVAR en producción pública (ver docker-compose.yml)
ADMINER_DESIGN=pepa-linha-dark

