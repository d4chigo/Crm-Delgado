# Variables de entorno para Docker Compose
# COPIAR ESTE ARCHIVO COMO .env Y CAMBIAR LOS VALORES

# Ambiente (development | production)
NODE_ENV=production

# Base de datos MySQL
MYSQL_ROOT_PASSWORD=root_password_super_seguro_2025
MYSQL_DATABASE=crm_delgado
MYSQL_USER=crm_user
MYSQL_PASSWORD=crm_password_super_seguro_2025

# JWT Secret (CAMBIAR EN PRODUCCIÓN - genera uno único)
JWT_SECRET=tu_jwt_secret_super_seguro_cambiar_en_produccion_123456
JWT_EXPIRES_IN=24h

# API URL (cambiar al dominio en producción)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Puertos (opcional, cambiar si hay conflictos)
MYSQL_PORT=3306
BACKEND_PORT=5000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
ADMINER_PORT=8080

# Adminer (Gestor de Base de Datos)
ADMINER_DESIGN=pepa-linha-dark
