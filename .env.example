# ==============================================
# CRM INMOBILIARIO - Variables de Entorno
# ==============================================
# 
# ⚠️ IMPORTANTE:
# Este archivo es una PLANTILLA. Copia este contenido a un archivo llamado .env
# en la raíz del proyecto. NUNCA subas el archivo .env a GitHub.
# 
# Instrucciones de uso:
# 1. Copia este archivo: cp .env.example .env
# 2. Edita .env con tus valores reales
# 3. Agrega .env a .gitignore (ya está configurado)
# 4. No compartas tu .env con nadie
# 
# ==============================================

# ==============================================
# 1. AMBIENTE
# ==============================================
# Valores: development, production, staging
NODE_ENV=development


# ==============================================
# 2. BASE DE DATOS MYSQL
# ==============================================
# 
# Estos valores se usan para crear el contenedor Docker de MySQL
# 
# MYSQL_ROOT_PASSWORD
#   - Contraseña del usuario root de MySQL
#   - Generar una segura: openssl rand -hex 12
#   - Ejemplo: a3f7b9c2e1d4
MYSQL_ROOT_PASSWORD=root_password_dev_2025

# MYSQL_DATABASE
#   - Nombre de la base de datos a crear
#   - Este mismo nombre se usa en DATABASE_URL
MYSQL_DATABASE=crm_delgado

# MYSQL_USER
#   - Usuario que puede acceder a MYSQL_DATABASE
#   - No puede ser 'root'
MYSQL_USER=crm_user

# MYSQL_PASSWORD
#   - Contraseña del usuario MYSQL_USER
#   - Generar una segura: openssl rand -hex 12
MYSQL_PASSWORD=crm_pass_dev_2025

# DATABASE_URL
#   - URL de conexión para Prisma
#   - Formato: mysql://usuario:password@host:puerto/base_datos
#   - host = 'mysql' en Docker, 'localhost' en desarrollo local
#   - NO EDITAR si usas Docker (se genera automáticamente)
DATABASE_URL=mysql://crm_user:crm_pass_dev_2025@mysql:3306/crm_delgado

# MYSQL_PORT
#   - Puerto donde corre MySQL en Docker
#   - Por defecto: 3306
MYSQL_PORT=3306


# ==============================================
# 3. AUTENTICACIÓN Y SEGURIDAD
# ==============================================
# 
# JWT_SECRET
#   - Clave secreta para firmar tokens JWT
#   - Generar una segura: openssl rand -hex 32
#   - ⚠️ CAMBIAR EN PRODUCCIÓN
#   - Ejemplo: a3f7b9c2e1d4f5a8b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3
JWT_SECRET=tu_jwt_secret_super_seguro_cambiar_en_produccion_123456

# JWT_EXPIRES_IN
#   - Tiempo de expiración del token
#   - Formatos: '24h', '7d', '1m'
JWT_EXPIRES_IN=24h

# BCRYPT_ROUNDS
#   - Complejidad del hash de contraseñas
#   - Rango recomendado: 10-12
#   - Mayor número = más seguro pero más lento
BCRYPT_ROUNDS=10


# ==============================================
# 4. API EXTERNA - CONSULTA DE DNI (PERÚ)
# ==============================================
# 
# Para obtener tu token GRATIS:
#   1. Ve a: https://apis.net.pe/
#   2. Regístrate (es gratis)
#   3. Crea una aplicación
#   4. Copia el token API
#   5. Pégalo aquí
# 
# DNI_API_TOKEN
#   - Token de autenticación para la API de DNI
#   - Se usa para consultar datos por DNI en formularios
#   - Gratis hasta 1000 consultas/mes
DNI_API_TOKEN=sk_10762.TrvGAsEZggD8fm9RdpKUtq17KyerYY6k


# ==============================================
# 5. URLS Y CORS
# ==============================================
# 
# CORS_ORIGIN
#   - URL del frontend (para permitir peticiones cross-origin)
#   - En desarrollo: http://localhost:3000
#   - En producción: https://tu-dominio.com
CORS_ORIGIN=http://localhost:3000

# NEXT_PUBLIC_API_URL
#   - URL base del backend (se expone al frontend)
#   - En desarrollo: http://localhost:5000/api
#   - En producción: https://api.tu-dominio.com
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# CLIENT_URL
#   - URL del cliente (para redirecciones)
#   - En desarrollo: http://localhost:3000
#   - En producción: https://tu-dominio.com
CLIENT_URL=http://localhost:3000


# ==============================================
# 6. GOOGLE OAUTH - CALENDARIO Y CONTACTOS
# ==============================================
# 
# Para obtener estas credenciales:
#   1. Ve a: https://console.cloud.google.com/
#   2. Crea un proyecto nuevo
#   3. Habilita las APIs: Google Calendar, Google Contacts
#   4. Ve a Credenciales → Crear Credenciales → OAuth 2.0
#   5. Tipo: Aplicación web
#   6. URLs autorizadas:
#      - http://localhost:5000/api/calendar/callback
#      - http://localhost:5000/api/auth/google/callback
#   7. Copia CLIENT_ID y CLIENT_SECRET
# 
# Documentación: Ver CONFIGURACION-GOOGLE.md
# 
# GOOGLE_CLIENT_ID
#   - ID público del cliente OAuth
#   - Formato: xxxxxx-xxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_ID=199058992191-0sqmua3i2742qvovg22lp2rnpp7gpmgh.apps.googleusercontent.com

# GOOGLE_CLIENT_SECRET
#   - Contraseña secreta del cliente OAuth
#   - ⚠️ NO COMPARTIR
#   - Formato: GOCSPX-xxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CLIENT_SECRET=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

# GOOGLE_REDIRECT_URI
#   - URL a donde Google redirige después de autenticar
#   - Debe estar registrada en Google Cloud Console
#   - En desarrollo: http://localhost:5000/api/calendar/callback
#   - En producción: https://api.tu-dominio.com/api/calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/api/calendar/callback


# ==============================================
# 7. GMAIL SMTP - NOTIFICACIONES POR EMAIL
# ==============================================
# 
# Para enviar emails GRATIS usando Gmail:
#   1. Ve a: https://myaccount.google.com/
#   2. Seguridad → Verificación 2FA (activar si no está)
#   3. Ve a: https://myaccount.google.com/apppasswords
#   4. Selecciona "Mail" y "Windows Computer"
#   5. Google genera una contraseña de 16 caracteres
#   6. Cópiala (sin espacios) y pégala en GMAIL_APP_PASSWORD
# 
# GMAIL_EMAIL
#   - Tu correo de Gmail
#   - Ejemplo: tu@gmail.com
GMAIL_EMAIL=webpruebas00617@gmail.com

# GMAIL_APP_PASSWORD
#   - Contraseña de aplicación (NO la contraseña normal de Gmail)
#   - Obtén una en: https://myaccount.google.com/apppasswords
#   - Formato: 16 caracteres sin espacios
#   - Ejemplo: aompamfuiglgdsyz
#   - ⚠️ NUNCA uses tu contraseña normal de Gmail
GMAIL_APP_PASSWORD=aomp amfu iglg dsyz


# ==============================================
# 8. GEMINI API - ASISTENTE IA BOT
# ==============================================
# 
# Para obtener tu API key:
#   1. Ve a: https://ai.google.dev/
#   2. Click en "Get started" o "API Key"
#   3. Crea un proyecto nuevo
#   4. Genera una API key
#   5. Pégala aquí
# 
# VITE_GOOGLE_API_KEY
#   - API key de Google Gemini (para el FRONTEND)
#   - Se usa en el chatbot del CRM
#   - Gratis: 60 solicitudes por minuto
#   - Documentación: https://ai.google.dev/
VITE_GOOGLE_API_KEY=AIzaSyBxWeGfCmYlHKhAlqp10nqd3Eftj5p7UbI
# 
# SERVER_GEMINI_API_KEY
#   - API key de Google Gemini (para el BACKEND - opcional)
#   - Se usa para el asistente IA del CRM
#   - Gratis: 60 solicitudes por minuto
#   - Documentación: https://ai.google.dev/
SERVER_GEMINI_API_KEY=AIzaSyBxWeGfCmYlHKhAlqp10nqd3Eftj5p7UbI


# ==============================================
# 9. PUERTOS (Opcional - cambiar si hay conflictos)
# ==============================================
# 
# Cambiar solo si estos puertos ya están en uso en tu computadora
# 
BACKEND_PORT=5000
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
ADMINER_PORT=8080


# ==============================================
# 10. ADMINER (Gestor Visual de Base de Datos)
# ==============================================
# 
# Adminer es una herramienta web para gestionar MySQL
# Acceso: http://localhost:8080
# 
# ADMINER_DESIGN
#   - Tema visual de Adminer
#   - Opciones: pepa-linha-dark, default, minimal
ADMINER_DESIGN=pepa-linha-dark


# ==============================================
# RESUMEN DE CONFIGURACIÓN RÁPIDA
# ==============================================
# 
# Mínimo para que funcione (ya está configurado por defecto):
#   ✅ NODE_ENV=development
#   ✅ DATABASE_URL (automático en Docker)
#   ✅ JWT_SECRET (cámbialo si quieres)
#   ✅ CORS_ORIGIN, NEXT_PUBLIC_API_URL, CLIENT_URL
# 
# Para activar funcionalidades:
#   ✅ DNI_API_TOKEN (consulta de DNI)
#   ✅ GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET (calendario)
#   ✅ GMAIL_EMAIL, GMAIL_APP_PASSWORD (emails)
#   ✅ VITE_GOOGLE_API_KEY (chatbot IA - IMPORTANTE)
#   ✅ SERVER_GEMINI_API_KEY (asistente IA backend - opcional)
# 
# Prioridad de implementación:
#   1️⃣ DNI API (fácil, muy útil)
#   2️⃣ Gmail (fácil, notificaciones críticas)
#   3️⃣ Google OAuth (medio, calendario)
#   4️⃣ Gemini API (opcional, cosmético)
# 
# ==============================================
# SEGURIDAD
# ==============================================
# 
# ✅ CORRECTO:
#   - Los valores sensibles en .env
#   - .env en .gitignore
#   - Diferentes valores para dev/prod
#   - Secrets seguros generados con openssl
# 
# ❌ INCORRECTO:
#   - Compartir archivo .env por chat/email
#   - Subir .env a GitHub
#   - Usar mismas credenciales dev/prod
#   - Valores hardcodeados en el código
#   - Contraseñas débiles (123456, password, etc)
# 
# ==============================================

