generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String               @id @default(uuid())
  nombre        String
  correo        String               @unique
  contrasena    String
  rol           Rol                  @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  leads         Lead[]
  clientes      Cliente[]
  oportunidades OportunidadCliente[]
  proyectos     Proyecto[]
  reportes      Reporte[]            @relation("UsuarioReportes")
  alertas       AlertaLead[]

  @@map("usuarios")
}

model Lead {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?            @map("fecha_nacimiento")
  creadoEn          DateTime             @default(now()) @map("creado_en")
  actualizadoEn     DateTime             @updatedAt @map("actualizado_en")
  idUsuario         String               @map("id_usuario")
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  estado            EstadoLead?          @default(NUEVO)
  fechaSeguimiento  DateTime?            @map("fecha_seguimiento")
  fuente            String?
  etiquetas         String?
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      LeadEtiqueta[]
  usuario           Usuario              @relation(fields: [idUsuario], references: [id])
  oportunidades     OportunidadCliente[]
  clientesAsociados LeadClienteAsociacion[] @relation("LeadRelacion")
  alertas           AlertaLead[]
  cotizaciones      Cotizacion[]

  @@index([idUsuario])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([estado])
  @@index([prioridad])
  @@map("leads")
}

model Cliente {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?            @map("fecha_nacimiento")
  creadoEn          DateTime             @default(now()) @map("creado_en")
  actualizadoEn     DateTime             @updatedAt @map("actualizado_en")
  idUsuario         String               @map("id_usuario")
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  fechaConversion   DateTime?            @map("fecha_conversion")
  fechaSeguimiento  DateTime?            @map("fecha_seguimiento")
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      ClienteEtiqueta[]
  usuario           Usuario              @relation(fields: [idUsuario], references: [id])
  cotizaciones      Cotizacion[]
  oportunidades     OportunidadCliente[]
  proyectos         ProyectoCliente[]
  leadsAsociados    LeadClienteAsociacion[] @relation("ClienteRelacion")

  @@index([idUsuario])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([prioridad])
  @@map("clientes")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")
  leads         LeadEtiqueta[]
  clientes      ClienteEtiqueta[]
  proyectos     ProyectoEtiqueta[]

  @@index([activa])
  @@index([activa, orden])
  @@map("etiquetas")
}

model LeadEtiqueta {
  idLead     String   @map("id_lead")
  idEtiqueta String   @map("id_etiqueta")
  asignadoEn DateTime @default(now()) @map("asignado_en")
  lead       Lead     @relation(fields: [idLead], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)

  @@id([idLead, idEtiqueta])
  @@index([idLead])
  @@index([idEtiqueta])
  @@map("lead_etiquetas")
}

model ClienteEtiqueta {
  idCliente  String   @map("id_cliente")
  idEtiqueta String   @map("id_etiqueta")
  asignadoEn DateTime @default(now()) @map("asignado_en")
  cliente    Cliente  @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)

  @@id([idCliente, idEtiqueta])
  @@index([idCliente])
  @@index([idEtiqueta])
  @@map("cliente_etiquetas")
}

model LeadClienteAsociacion {
  idLead     String   @map("id_lead")
  idCliente  String   @map("id_cliente")
  asociadoEn DateTime @default(now()) @map("asociado_en")
  notas      String?
  estado     String?
  cliente    Cliente  @relation("ClienteRelacion", fields: [idCliente], references: [id], onDelete: Cascade)
  lead       Lead     @relation("LeadRelacion", fields: [idLead], references: [id], onDelete: Cascade)

  @@id([idLead, idCliente])
  @@index([idLead])
  @@index([idCliente])
  @@map("lead_cliente_asociaciones")
}

model OportunidadCliente {
  id              String        @id @default(uuid())
  idLead         String?        @map("id_lead")
  idCliente      String?        @map("id_cliente")
  titulo          String
  proyecto        String?
  propiedad       String?
  etapa           String        @default("CONTACTO_INICIAL")
  valor           Float?
  probabilidad    Int?          @default(25)
  proximaAccion  String?        @map("proxima_accion")
  ultimaActividad DateTime      @default(now()) @map("ultima_actividad")
  notas           String?
  creadoEn       DateTime      @default(now()) @map("creado_en")
  actualizadoEn  DateTime      @updatedAt @map("actualizado_en")
  idUsuario      String        @map("id_usuario")
  lead            Lead?         @relation(fields: [idLead], references: [id], onDelete: Cascade)
  cliente         Cliente?      @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [idUsuario], references: [id])

  @@index([idLead])
  @@index([idCliente])
  @@index([idUsuario])
  @@index([etapa])
  @@index([creadoEn])
  @@map("oportunidades_clientes")
}

model HistorialPipelineLead {
  id                    String        @id @default(uuid())
  idOportunidad         String        @map("id_oportunidad")
  idLead                String        @map("id_lead")
  etapaAnterior         String        @map("etapa_anterior")
  etapaNueva            String        @map("etapa_nueva")
  probabilidadAnterior  Int?          @map("probabilidad_anterior")
  probabilidadNueva     Int?          @map("probabilidad_nueva")
  valorAnterior         Float?        @map("valor_anterior")
  valorNuevo            Float?        @map("valor_nuevo")
  cambiadoEn            DateTime      @default(now()) @map("cambiado_en")
  cambiadoPor           String        @map("cambiado_por")
  notas                 String?       @db.Text
  razon                 String?

  @@index([idOportunidad])
  @@index([idLead])
  @@index([cambiadoPor])
  @@index([cambiadoEn])
  @@index([etapaNueva])
  @@map("historial_etapas_leads")
}

model ProyectoEtiqueta {
  idProyecto String   @map("id_proyecto")
  idEtiqueta String   @map("id_etiqueta")
  asignadoEn DateTime @default(now()) @map("asignado_en")
  etiqueta   Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [idProyecto], references: [id], onDelete: Cascade)

  @@id([idProyecto, idEtiqueta])
  @@index([idProyecto])
  @@index([idEtiqueta])
  @@map("etiquetas_proyectos")
}

model ProyectoCliente {
  idProyecto String   @map("id_proyecto")
  idCliente  String   @map("id_cliente")
  asociadoEn DateTime @default(now()) @map("asociado_en")
  notas      String?
  cliente    Cliente  @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [idProyecto], references: [id], onDelete: Cascade)

  @@id([idProyecto, idCliente])
  @@index([idProyecto])
  @@index([idCliente])
  @@map("clientes_proyectos")
}

model ProyectoContacto {
  idProyecto String   @map("id_proyecto")
  idContacto String   @map("id_contacto")
  tipoContacto String @map("tipo_contacto") // 'CLIENTE' o 'LEAD'
  asociadoEn DateTime @default(now()) @map("asociado_en")
  notas      String?
  proyecto   Proyecto @relation("ProyectoContactos", fields: [idProyecto], references: [id], onDelete: Cascade)

  @@id([idProyecto, idContacto])
  @@index([idProyecto])
  @@index([idContacto])
  @@map("contactos_proyectos")
}

model Cotizacion {
  id                      String           @id @default(uuid())
  idLead                  String?          @map("id_lead")
  idCliente               String?          @map("id_cliente")
  numeroReferencia        String           @unique @map("numero_referencia")
  nombreProyecto          String           @map("nombre_proyecto")
  tipoInmueble            String?          @map("tipo_inmueble")
  descripcion             String?
  precioInmueble          Float            @map("precio_inmueble")
  cuotaInicial            Float            @map("cuota_inicial")
  porcentajeCuotaInicial  Float            @map("porcentaje_cuota_inicial")
  montoFinanciar          Float            @map("monto_financiar")
  plazoMeses              Int              @map("plazo_meses")
  tipoCuota               TipoCuota        @default(FIJA) @map("tipo_cuota")
  tasaInteresAnual        Float            @map("tasa_interes_anual")
  permitePostergar        Boolean          @default(false) @map("permite_postergar")
  cuotasPostergables      Int?             @map("cuotas_postergables")
  permiteDoble            Boolean          @default(false) @map("permite_doble")
  cuotasDobleAnuales      Int?             @map("cuotas_dobles_anuales")
  permiteCambioFecha      Boolean          @default(false) @map("permite_cambio_fecha")
  montoCuotaManual        Float?           @map("monto_cuota_manual")
  cuotaMensualEstimada    Float            @map("cuota_mensual_estimada")
  totalIntereses          Float            @map("total_intereses")
  totalPagar              Float            @map("total_pagar")
  estado                  EstadoCotizacion @default(BORRADOR)
  notas                   String?
  observaciones           String?
  fechaValidez            DateTime?        @map("fecha_validez")
  creadoEn                DateTime         @default(now()) @map("creado_en")
  actualizadoEn           DateTime         @updatedAt @map("actualizado_en")
  lead                    Lead?            @relation(fields: [idLead], references: [id], onDelete: Cascade)
  cliente                 Cliente?         @relation(fields: [idCliente], references: [id], onDelete: Cascade)

  @@index([idLead])
  @@index([idCliente])
  @@index([estado])
  @@index([tipoCuota])
  @@map("cotizaciones")
}

model Reporte {
  id                String   @id @default(uuid())
  tipo              String
  parametros        Json?
  resultadosResumen Json?    @map("resultados_resumen")
  generadoPor       String?  @map("generado_por")
  generadoEn        DateTime @default(now()) @map("generado_en")
  usuario           Usuario? @relation("UsuarioReportes", fields: [generadoPor], references: [id])

  @@index([generadoPor])
  @@map("reportes")
}

model Notificacion {
  id              String   @id @default(uuid())
  titulo          String
  descripcion     String   @db.Text
  tipo            String   @default("INFO")
  leida           Boolean  @default(false)
  idUsuario       String?  @map("id_usuario")
  idContacto      String?  @map("id_contacto")
  referencia      String?  // ID del recurso relacionado (lead, contacto, etc)
  tipoReferencia  String?  @map("tipo_referencia") // Tipo de recurso (LEAD, CONTACTO, OPORTUNIDAD, etc)
  creadoEn        DateTime @default(now()) @map("creado_en")
  leidaEn         DateTime? @map("leida_en")

  @@index([idUsuario])
  @@index([idContacto])
  @@index([leida])
  @@index([creadoEn])
  @@index([tipoReferencia])
  @@map("notificaciones")
}

model Proyecto {
  id              String             @id @default(uuid())
  nombre          String
  descripcion     String?            @db.Text
  imagen          String?
  precio          Float?
  ubicacion       String?
  latitud         Float?
  longitud        Float?
  estado          EstadoProyecto     @default(DISPONIBLE)
  activo          Boolean            @default(true)
  tipoProyecto    TipoProyecto?      @map("tipo_proyecto")
  categoria       String?
  galeria         Json?
  caracteristicas Json?
  mostrarEnWeb    Boolean            @default(true) @map("mostrar_en_web")
  ordenWeb        Int?               @map("orden_web")
  creadoEn        DateTime           @default(now()) @map("creado_en")
  actualizadoEn   DateTime           @updatedAt @map("actualizado_en")
  idUsuario       String             @map("id_usuario")
  clientes        ProyectoCliente[]
  contactos       ProyectoContacto[] @relation("ProyectoContactos")
  etiquetas       ProyectoEtiqueta[]
  usuario         Usuario            @relation(fields: [idUsuario], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([idUsuario])
  @@index([tipoProyecto])
  @@index([mostrarEnWeb])
  @@map("proyectos")
}

// ==================== MODELO PARA ALERTAS DE LEADS ====================
model AlertaLead {
  id            String   @id @default(uuid())
  idLead        String?  @map("id_lead")
  idUsuario     String   @map("id_usuario")
  fechaCreada   DateTime @default(now()) @map("fecha_creada")
  fechaLimite   DateTime @map("fecha_limite") // 24 horas desde creación
  completada    Boolean  @default(false)
  completadaEn  DateTime? @map("completada_en")
  notas         String?  @db.Text
  lead          Lead?    @relation(fields: [idLead], references: [id], onDelete: Cascade)
  usuario       Usuario  @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario])
  @@index([idLead])
  @@index([completada])
  @@index([fechaLimite])
  @@index([fechaCreada])
  @@map("alertas_leads")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoCuota {
  FIJA
  FLEXIBLE
  FLEXIBLE_ESPECIAL
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum EstadoProyecto {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CONSTRUCCION
  FINALIZADO
}

enum TipoProyecto {
  TECHO_PROPIO       @map("techo_propio")
  CREDITO_MIVIVIENDA @map("credito_mivivienda")
  HABILITACIONES     @map("habilitaciones")
  COMPRA             @map("compra")
  VENTA              @map("venta")
  ALQUILER           @map("alquiler")
  DEPARTAMENTO       @map("departamento")
  CASA               @map("casa")
  TERRENO            @map("terreno")
  LOCAL_COMERCIAL    @map("local_comercial")
}

// ==================== MODELOS PARA PANEL ADMIN WEB (PHP) ====================
// Estos modelos mapean a tablas legacy del sitio PHP

enum TipoServicio {
  GENERAL    @map("general")
  TOPOGRAFIA @map("topografia")
  DRON       @map("dron")
}

enum EstadoTestimonio {
  PENDIENTE @map("pendiente")
  APROBADO  @map("aprobado")
  RECHAZADO @map("rechazado")
}

// Otros servicios para el sitio web
model OtrosServicios {
  id               Int          @id @default(autoincrement())
  titulo           String
  descripcion      String?
  caracteristicas  String?      @db.LongText  // JSON array as string
  imagenes         String?      @db.LongText  // JSON array as string
  enlace_imagen    String?
  enlace_video     String?
  tipo_servicio    TipoServicio @default(GENERAL)
  creado_en        DateTime     @default(now())
  actualizado_en   DateTime     @updatedAt

  @@map("servicios_adicionales")
}

// Miembros del equipo para el sitio web
model MiembroEquipo {
  id             Int       @id @default(autoincrement())
  nombre         String
  cargo          String
  descripcion    String    @db.LongText
  correo         String
  telefono       String
  foto           String?   @db.LongText
  activo         Boolean   @default(true)
  orden_mostrar  Int
  facebook       String?
  instagram      String?
  tiktok         String?
  creado_en      DateTime  @default(now())
  actualizado_en DateTime? @updatedAt

  @@index([activo])
  @@index([orden_mostrar])
  @@map("miembros_equipo")
}

// Testimonios para el sitio web
model Testimonio {
  id             Int              @id @default(autoincrement())
  nombre         String
  correo         String
  calificacion   Int
  testimonio     String           @db.Text
  foto           String?
  media          String?
  video_url      String?
  estado         EstadoTestimonio @default(APROBADO)
  creado_en      DateTime
  aprobado_en    DateTime?

  @@index([estado])
  @@map("testimonios")
}

// Páginas de servicios para el sitio web (Techo Propio, Crédito, etc.)
model PaginaServicio {
  id                String    @id @default(uuid())
  tipo_servicio     TipoProyecto
  titulo            String
  subtitulo         String?
  descripcion_corta String?
  descripcion_larga String?
  imagen_banner     String?
  video_banner      String?
  requisitos        Json?
  beneficios        Json?
  pasos             Json?
  preguntas         Json?
  activo            Boolean   @default(true)
  orden_mostrar     Int       @default(0)
  meta_title        String?
  meta_description  String?
  creado_en         DateTime  @default(now())
  actualizado_en    DateTime  @updatedAt

  @@unique([tipo_servicio])
  @@index([activo])
  @@index([orden_mostrar])
  @@map("paginas_servicios")
}

// ==================== MODELOS PARA PORTAL DE CLIENTES ====================

// Contraseñas para acceso web de clientes
model ClientePassword {
  id_contacto   String   @id
  contrasena_web String
  activo        Boolean  @default(true)
  creado_en     DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("contrasenas_clientes")
}

// Documentos subidos por clientes
model ClienteDocumento {
  id              String   @id @default(uuid())
  id_contacto     String
  nombre_archivo  String
  nombre_original String
  ruta_archivo    String
  tipo_documento  String
  descripcion     String?
  tamano_bytes    Int
  mime_type       String
  subido_en       DateTime @default(now())
  estado          String   @default("PENDIENTE")
  revisado_por    String?
  revisado_en     DateTime?
  notas           String?

  @@index([id_contacto])
  @@index([estado])
  @@index([subido_en])
  @@map("documentos_clientes")
}

// Registro de accesos al portal
model ClienteAcceso {
  id             String   @id @default(uuid())
  id_contacto    String
  fecha_acceso   DateTime @default(now())
  ip_address     String
  user_agent     String?

  @@index([id_contacto])
  @@index([fecha_acceso])
  @@map("accesos_clientes")
}

// Actividades del cliente en el portal
model ClienteActividad {
  id          String   @id @default(uuid())
  id_contacto String
  tipo        String
  descripcion String
  fecha       DateTime @default(now())
  metadata    Json?

  @@index([id_contacto])
  @@index([fecha])
  @@map("actividades_clientes")
}
