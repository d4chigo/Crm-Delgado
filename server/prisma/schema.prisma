generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Usuario {
  id            String               @id @default(uuid())
  nombre        String
  email         String               @unique
  password      String
  rol           Rol                  @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  contactos     Contacto[]
  oportunidades OportunidadCliente[]
  proyectos     proyectos[]
  reportes      Reporte[]            @relation("UsuarioReportes")

  @@map("usuarios")
}

model Contacto {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?
  tipo              TipoContacto         @default(CONTACTO)
  creadoEn          DateTime             @default(now())
  actualizadoEn     DateTime             @updatedAt
  usuarioId         String
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  estadoLead        EstadoLead?
  fechaConversion   DateTime?
  fechaSeguimiento  DateTime?
  fuente            String?
  intereses         String?              @db.Text
  notas             String?              @db.Text
  presupuesto       Decimal?             @db.Decimal(10, 2)
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetas         ContactoEtiqueta[]
  usuario           Usuario              @relation(fields: [usuarioId], references: [id])
  cotizaciones      Cotizacion[]
  clientesAsociados LeadCliente[]        @relation("ClienteRelacion")
  leadsAsociados    LeadCliente[]        @relation("LeadRelacion")
  oportunidades     OportunidadCliente[]
  proyectos         ProyectoCliente[]

  @@index([usuarioId])
  @@index([tipo])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([estadoLead])
  @@index([prioridad])
  @@map("contactos")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  contactos     ContactoEtiqueta[]
  proyectos     ProyectoEtiqueta[]

  @@index([activa])
  @@index([activa, orden])
  @@map("etiquetas")
}

model ContactoEtiqueta {
  contactoId String
  etiquetaId String
  asignadoEn DateTime @default(now())
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([contactoId, etiquetaId])
  @@index([contactoId])
  @@index([etiquetaId])
  @@map("contacto_etiquetas")
}

model LeadCliente {
  leadId     String
  clienteId  String
  asociadoEn DateTime @default(now())
  notas      String?  @db.Text
  estado     String?  @db.VarChar(50)
  cliente    Contacto @relation("ClienteRelacion", fields: [clienteId], references: [id], onDelete: Cascade)
  lead       Contacto @relation("LeadRelacion", fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, clienteId])
  @@index([leadId])
  @@index([clienteId])
  @@map("lead_clientes")
}

model OportunidadCliente {
  id              String        @id @default(uuid())
  clienteId       String
  titulo          String
  proyecto        String?
  propiedad       String?
  etapa           EtapaPipeline @default(LEAD)
  valor           Decimal?      @db.Decimal(12, 2)
  probabilidad    Int?          @default(25)
  proximaAccion   String?       @db.Text
  ultimaActividad DateTime      @default(now())
  notas           String?       @db.Text
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt
  usuarioId       String
  cliente         Contacto      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([clienteId])
  @@index([usuarioId])
  @@index([etapa])
  @@index([creadoEn])
  @@map("oportunidades_clientes")
}

model ProyectoEtiqueta {
  proyectoId String
  etiquetaId String
  asignadoEn DateTime  @default(now())
  etiqueta   Etiqueta  @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  proyecto   proyectos @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, etiquetaId])
  @@index([proyectoId])
  @@index([etiquetaId])
  @@map("proyecto_etiquetas")
}

model ProyectoCliente {
  proyectoId String
  clienteId  String
  asociadoEn DateTime  @default(now())
  notas      String?   @db.Text
  cliente    Contacto  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  proyecto   proyectos @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, clienteId])
  @@index([proyectoId])
  @@index([clienteId])
  @@map("proyecto_clientes")
}

model Cotizacion {
  id                     String           @id @default(uuid())
  contactoId             String
  numeroReferencia       String           @unique
  nombreProyecto         String
  tipoInmueble           String?
  descripcion            String?          @db.Text
  precioInmueble         Decimal          @db.Decimal(12, 2)
  cuotaInicial           Decimal          @db.Decimal(12, 2)
  porcentajeCuotaInicial Decimal          @db.Decimal(5, 2)
  montoFinanciar         Decimal          @db.Decimal(12, 2)
  plazoMeses             Int
  tipoCuota              TipoCuota        @default(FIJA)
  tasaInteresAnual       Decimal          @db.Decimal(5, 2)
  permitePostergar       Boolean          @default(false)
  cuotasPostergables     Int?
  permiteDoble           Boolean          @default(false)
  cuotasDoblesAnuales    Int?
  permiteCambioFecha     Boolean          @default(false)
  montoCuotaManual       Decimal?         @db.Decimal(12, 2)
  cuotaMensualEstimada   Decimal          @db.Decimal(12, 2)
  totalIntereses         Decimal          @db.Decimal(12, 2)
  totalPagar             Decimal          @db.Decimal(12, 2)
  estado                 EstadoCotizacion @default(BORRADOR)
  notas                  String?          @db.Text
  observaciones          String?          @db.Text
  fechaValidez           DateTime?
  creadoEn               DateTime         @default(now())
  actualizadoEn          DateTime         @updatedAt
  contacto               Contacto         @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@index([contactoId])
  @@index([estado])
  @@index([tipoCuota])
  @@map("cotizaciones")
}

model Reporte {
  id                String   @id @default(uuid())
  tipo              String
  parametros        Json?
  resultadosResumen Json?
  generadoPor       String?
  generadoEn        DateTime @default(now())
  usuario           Usuario? @relation("UsuarioReportes", fields: [generadoPor], references: [id])

  @@index([generadoPor])
  @@map("reportes")
}

model proyectos {
  id            String             @id
  nombre        String
  descripcion   String?            @db.Text
  imagen        String?
  precio        Decimal?           @db.Decimal(12, 2)
  ubicacion     String?
  estado        proyectos_estado   @default(DISPONIBLE)
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime
  usuarioId     String
  clientes      ProyectoCliente[]
  etiquetas     ProyectoEtiqueta[]
  usuarios      Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([usuarioId])
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum TipoContacto {
  CONTACTO
  LEAD
  CLIENTE
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EtapaPipeline {
  LEAD
  CONTACTO
  VISITA
  NEGOCIACION
  CIERRE
  GANADO
  PERDIDO
}

enum TipoCuota {
  FIJA
  FLEXIBLE
  FLEXIBLE_ESPECIAL
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum proyectos_estado {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CONSTRUCCION
  FINALIZADO
}

// Enum para valores 'si'/'no' en la BD legacy
enum SiNo {
  SI @map("si")
  NO @map("no")
}

// Estados de propiedad (mapear a los valores en la BD: available/sold/reserved)
enum EstadoPropiedad {
  DISPONIBLE @map("available")
  VENDIDO     @map("sold")
  RESERVADO   @map("reserved")
}

// Tipos de propiedad (mapear a: house, apartment, land, commercial)
enum TipoPropiedad {
  CASA         @map("house")
  DEPARTAMENTO @map("apartment")
  TERRENO      @map("land")
  COMERCIAL    @map("commercial")
}

// Estado de consultas (inquiries)
enum EstadoConsulta {
  PENDIENTE   @map("pending")
  EN_PROGRESO @map("in_progress")
  RESUELTA    @map("resolved")
}

// Tipos de servicio para 'otros_servicios'
enum TipoServicio {
  GENERAL    @map("general")
  TOPOGRAFIA @map("topografia")
  DRON       @map("dron")
}

// Estado de testimonios
enum EstadoTestimonio {
  PENDIENTE @map("pending")
  APROBADO  @map("approved")
  RECHAZADO @map("rejected")
}

// Estado de contacto para credit_evaluations
enum EstadoContacto {
  PENDIENTE      @map("pending")
  CONTACTADO     @map("contacted")
  NO_INTERESADO  @map("not_interested")
  SEGUIMIENTO    @map("follow_up")
}

// Modelo: propiedades (tabla legacy `properties`) - en español
model Propiedad {
  id             Int               @id @default(autoincrement()) @map("id")
  titulo         String            @map("title")
  descripcion    String            @map("description") @db.Text
  precio         Decimal?          @map("price") @db.Decimal(10, 2)
  direccion      String            @map("address")
  ciudad         String            @map("city")
  habitaciones   Int               @map("bedrooms")
  banos          Int               @map("bathrooms")
  area           Decimal?          @map("area") @db.Decimal(10, 2)
  destacado      Boolean?          @map("featured") @default(false)
  estado         EstadoPropiedad   @map("status") @default(DISPONIBLE)
  tipo_propiedad TipoPropiedad     @map("property_type")
  creado_en      DateTime          @map("created_at")
  actualizado_en DateTime?         @map("updated_at") @updatedAt
  es_destacado   Boolean?          @map("is_featured") @default(false)
  mapa_url       String?           @map("map_url") @db.VarChar(500)
  video_url      String?           @map("video_url") @db.Text
  etiqueta       String?           @map("tag") @db.VarChar(50)
  imagenes       ImagenPropiedad[] @relation("PropiedadImagenes")
  consultas      Consulta[]

  @@map("properties")
}

// Modelo: imagenes de propiedad (property_images)
model ImagenPropiedad {
  id           Int       @id @default(autoincrement()) @map("id")
  propiedad_id Int       @map("property_id")
  ruta_imagen   String    @map("image_path") @db.VarChar(255)
  es_principal Boolean   @map("is_main") @default(false)
  creado_en    DateTime  @map("created_at")

  propiedad    Propiedad @relation("PropiedadImagenes", fields: [propiedad_id], references: [id], onDelete: Cascade)

  @@map("property_images")
  @@index([propiedad_id], name: "property_id")
}

// Modelo: consultas (inquiries)
model Consulta {
  id           Int            @id @default(autoincrement()) @map("id")
  nombre       String         @map("name") @db.VarChar(100)
  correo       String         @map("email") @db.VarChar(100)
  telefono     String         @map("phone") @db.VarChar(20)
  asunto       String         @map("subject") @db.VarChar(255)
  mensaje      String         @map("message") @db.Text
  propiedad_id Int?           @map("property_id")
  estado       EstadoConsulta @map("status") @default(PENDIENTE)
  creado_en    DateTime       @map("created_at")
  resuelto_en  DateTime?      @map("resolved_at")

  propiedad    Propiedad?     @relation(fields: [propiedad_id], references: [id], onDelete: SetNull)

  @@map("inquiries")
}

// Modelo: chequeos de elegibilidad (eligibility_checks)
model ChequeoElegibilidad {
  id               Int      @id @default(autoincrement()) @map("id")
  nombre_completo  String   @map("full_name") @db.VarChar(100)
  dni              String   @map("dni") @db.VarChar(20)
  ingreso_mensual  Decimal  @map("monthly_income") @db.Decimal(10, 2)
  miembros_familia Int      @map("family_members")
  propiedad_propia String   @map("own_property") @db.VarChar(20)
  modalidad        String   @map("modality") @db.VarChar(20)
  ahorros          Decimal  @map("savings") @db.Decimal(10, 2)
  correo           String   @map("email") @db.VarChar(100)
  telefono         String   @map("phone") @db.VarChar(20)
  ciudad           String?  @map("city") @db.VarChar(100)
  elegible         Boolean  @map("eligible")
  mensaje          String?  @map("message") @db.Text
  creado_en        DateTime @map("created_at")
  contactado       Boolean  @map("contacted") @default(false)
  inalcanzable     Boolean  @map("unreachable") @default(false)
  agendado         Boolean  @map("scheduled") @default(false)
  contactado_en    DateTime? @map("contacted_at")
  notas_contacto   String?  @map("contact_notes") @db.Text
  ingreso_excede   SiNo     @map("income_exceeds") @default(NO)
  apoyo_previo     SiNo     @map("previous_support") @default(NO)
  tiene_familia    SiNo     @map("has_family") @default(NO)
  tiene_ahorros    SiNo     @map("has_savings") @default(NO)

  @@map("eligibility_checks")
}

// Modelo: otros servicios (otros_servicios)
model OtrosServicios {
  id            Int        @id @default(autoincrement()) @map("id")
  titulo        String     @map("title") @db.VarChar(255)
  descripcion   String?    @map("description") @db.Text
  enlace_imagen String?    @map("image_link") @db.VarChar(512)
  enlace_video  String?    @map("video_link") @db.VarChar(512)
  creado_en     DateTime   @map("created_at") @default(now())
  actualizado_en DateTime  @map("updated_at") @updatedAt
  tipo_servicio TipoServicio @map("service_type") @default(GENERAL)

  @@map("otros_servicios")
}

// Modelo: miembros de equipo (team_members)
model MiembroEquipo {
  id            Int       @id @default(autoincrement()) @map("id")
  nombre        String    @map("name") @db.VarChar(100)
  cargo         String    @map("position") @db.VarChar(100)
  descripcion   String    @map("description") @db.Text
  correo        String    @map("email") @db.VarChar(100)
  telefono      String    @map("phone") @db.VarChar(20)
  foto          String?   @map("photo") @db.VarChar(255)
  activo        Boolean   @map("active") @default(true)
  orden_mostrar Int       @map("display_order")
  creado_en     DateTime  @map("created_at") @default(now())
  facebook      String?   @map("facebook")
  instagram     String?   @map("instagram")
  tiktok        String?   @map("tiktok")
  actualizado_en DateTime? @map("updated_at")

  @@map("team_members")
}

// Modelo: testimonios (testimonials)
model Testimonio {
  id           Int             @id @default(autoincrement()) @map("id")
  nombre       String          @map("name") @db.VarChar(100)
  correo       String          @map("email") @db.VarChar(100)
  cargo        String          @map("role") @db.VarChar(100)
  calificacion Int             @map("rating")
  testimonio   String          @map("testimonial") @db.Text
  foto         String?         @map("photo") @db.VarChar(255)
  media        String?         @map("media") @db.VarChar(255)
  video_url    String?         @map("video_url") @db.VarChar(255)
  estado       EstadoTestimonio @map("status") @default(APROBADO)
  creado_en    DateTime        @map("created_at")
  aprobado_en  DateTime?       @map("approved_at")

  @@map("testimonials")
}

// Modelo: usuarios legacy (tabla `users`) - separado del modelo `Usuario` del CRM
model UsuarioWeb {
  id             Int      @id @default(autoincrement()) @map("id")
  nombre         String   @map("name") @db.VarChar(100)
  correo         String   @map("email") @unique @db.VarChar(100)
  telefono       String   @map("phone") @db.VarChar(20)
  password       String   @map("password") @db.VarChar(255)
  rol_usuario    String   @map("role") @db.VarChar(20) @default("user")
  remember_token String?  @map("remember_token") @db.VarChar(100)
  token_expira   BigInt?  @map("token_expires")
  creado_en      DateTime @map("created_at")
  actualizado_en DateTime? @map("updated_at")

  @@map("users")
}

// Modelo: evaluaciones de crédito (credit_evaluations)
model EvaluacionCredito {
  id              Int            @id @default(autoincrement()) @map("id")
  nombre_completo String         @map("full_name") @db.VarChar(100)
  dni             String?        @map("dni") @db.VarChar(20)
  elegible        Boolean?       @map("eligible")
  contactado      Boolean        @map("contacted") @default(false)
  creado_en       DateTime       @map("created_at")
  estado_contacto EstadoContacto @map("contact_status") @default(PENDIENTE)

  @@map("credit_evaluations")
}
