generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String               @id @default(uuid())
  nombre        String
  correo        String               @unique
  contrasena    String
  rol           Rol                  @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  leads         Lead[]
  clientes      Cliente[]
  oportunidades OportunidadCliente[]
  proyectos     Proyecto[]
  reportes      Reporte[]            @relation("UsuarioReportes")
  alertas       AlertaLead[]

  @@map("usuarios")
}

model Lead {
  id                String                  @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?               @map("fecha_nacimiento")
  creadoEn          DateTime                @default(now()) @map("creado_en")
  actualizadoEn     DateTime                @updatedAt @map("actualizado_en")
  idUsuario         String                  @map("id_usuario")
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  estado            EstadoLead?             @default(NUEVO)
  fechaSeguimiento  DateTime?               @map("fecha_seguimiento")
  fuente            String?
  etiquetas         String?
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad               @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      LeadEtiqueta[]
  usuario           Usuario                 @relation(fields: [idUsuario], references: [id])
  oportunidades     OportunidadCliente[]
  clientesAsociados LeadClienteAsociacion[] @relation("LeadRelacion")
  alertas           AlertaLead[]
  cotizaciones      Cotizacion[]

  @@index([idUsuario])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([estado])
  @@index([prioridad])
  @@map("leads")
}

model Cliente {
  id               String                  @id @default(uuid())
  nombre           String
  apellido         String?
  correo           String?
  telefono         String?
  direccion        String?
  ciudad           String?
  dni              String?
  sexo             Sexo?
  fechaNacimiento  DateTime?               @map("fecha_nacimiento")
  creadoEn         DateTime                @default(now()) @map("creado_en")
  actualizadoEn    DateTime                @updatedAt @map("actualizado_en")
  idUsuario        String                  @map("id_usuario")
  cargo            String?
  departamento     String?
  distrito         String?
  empresa          String?
  fechaConversion  DateTime?               @map("fecha_conversion")
  fechaSeguimiento DateTime?               @map("fecha_seguimiento")
  notas            String?
  presupuesto      Float?
  prioridad        Prioridad               @default(MEDIA)
  probabilidad     Int?
  provincia        String?
  etiquetasRel     ClienteEtiqueta[]
  usuario          Usuario                 @relation(fields: [idUsuario], references: [id])
  cotizaciones     Cotizacion[]
  oportunidades    OportunidadCliente[]
  proyectos        ProyectoCliente[]
  leadsAsociados   LeadClienteAsociacion[] @relation("ClienteRelacion")

  @@index([idUsuario])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([prioridad])
  @@map("clientes")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creadoEn      DateTime           @default(now()) @map("creado_en")
  actualizadoEn DateTime           @updatedAt @map("actualizado_en")
  leads         LeadEtiqueta[]
  clientes      ClienteEtiqueta[]
  proyectos     ProyectoEtiqueta[]

  @@index([activa])
  @@index([activa, orden])
  @@map("etiquetas")
}

model LeadEtiqueta {
  idLead     String   @map("id_lead")
  idEtiqueta String   @map("id_etiqueta")
  asignadoEn DateTime @default(now()) @map("asignado_en")
  lead       Lead     @relation(fields: [idLead], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)

  @@id([idLead, idEtiqueta])
  @@index([idLead])
  @@index([idEtiqueta])
  @@map("lead_etiquetas")
}

model ClienteEtiqueta {
  idCliente  String   @map("id_cliente")
  idEtiqueta String   @map("id_etiqueta")
  asignadoEn DateTime @default(now()) @map("asignado_en")
  cliente    Cliente  @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)

  @@id([idCliente, idEtiqueta])
  @@index([idCliente])
  @@index([idEtiqueta])
  @@map("cliente_etiquetas")
}

model LeadClienteAsociacion {
  idLead     String   @map("id_lead")
  idCliente  String   @map("id_cliente")
  asociadoEn DateTime @default(now()) @map("asociado_en")
  notas      String?
  estado     String?
  cliente    Cliente  @relation("ClienteRelacion", fields: [idCliente], references: [id], onDelete: Cascade)
  lead       Lead     @relation("LeadRelacion", fields: [idLead], references: [id], onDelete: Cascade)

  @@id([idLead, idCliente])
  @@index([idLead])
  @@index([idCliente])
  @@map("lead_cliente_asociaciones")
}

model OportunidadCliente {
  id              String   @id @default(uuid())
  idLead          String?  @map("id_lead")
  idCliente       String?  @map("id_cliente")
  titulo          String
  proyecto        String?
  propiedad       String?
  etapa           String   @default("CONTACTO_INICIAL")
  valor           Float?
  probabilidad    Int?     @default(25)
  proximaAccion   String?  @map("proxima_accion")
  ultimaActividad DateTime @default(now()) @map("ultima_actividad")
  notas           String?
  creadoEn        DateTime @default(now()) @map("creado_en")
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")
  idUsuario       String   @map("id_usuario")
  lead            Lead?    @relation(fields: [idLead], references: [id], onDelete: Cascade)
  cliente         Cliente? @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  usuario         Usuario  @relation(fields: [idUsuario], references: [id])

  @@index([idLead])
  @@index([idCliente])
  @@index([idUsuario])
  @@index([etapa])
  @@index([creadoEn])
  @@map("oportunidades_clientes")
}

model ProyectoEtiqueta {
  idProyecto String   @map("id_proyecto")
  idEtiqueta String   @map("id_etiqueta")
  asignadoEn DateTime @default(now()) @map("asignado_en")
  etiqueta   Etiqueta @relation(fields: [idEtiqueta], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [idProyecto], references: [id], onDelete: Cascade)

  @@id([idProyecto, idEtiqueta])
  @@index([idProyecto])
  @@index([idEtiqueta])
  @@map("etiquetas_proyectos")
}

model ProyectoCliente {
  idProyecto String   @map("id_proyecto")
  idCliente  String   @map("id_cliente")
  asociadoEn DateTime @default(now()) @map("asociado_en")
  notas      String?
  cliente    Cliente  @relation(fields: [idCliente], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [idProyecto], references: [id], onDelete: Cascade)

  @@id([idProyecto, idCliente])
  @@index([idProyecto])
  @@index([idCliente])
  @@map("clientes_proyectos")
}

model Cotizacion {
  id                     String           @id @default(uuid())
  idLead                 String?          @map("id_lead")
  idCliente              String?          @map("id_cliente")
  numeroReferencia       String           @unique @map("numero_referencia")
  nombreProyecto         String           @map("nombre_proyecto")
  tipoInmueble           String?          @map("tipo_inmueble")
  descripcion            String?
  precioInmueble         Float            @map("precio_inmueble")
  cuotaInicial           Float            @map("cuota_inicial")
  porcentajeCuotaInicial Float            @map("porcentaje_cuota_inicial")
  montoFinanciar         Float            @map("monto_financiar")
  plazoMeses             Int              @map("plazo_meses")
  tipoCuota              TipoCuota        @default(FIJA) @map("tipo_cuota")
  tasaInteresAnual       Float            @map("tasa_interes_anual")
  permitePostergar       Boolean          @default(false) @map("permite_postergar")
  cuotasPostergables     Int?             @map("cuotas_postergables")
  permiteDoble           Boolean          @default(false) @map("permite_doble")
  cuotasDobleAnuales     Int?             @map("cuotas_dobles_anuales")
  permiteCambioFecha     Boolean          @default(false) @map("permite_cambio_fecha")
  montoCuotaManual       Float?           @map("monto_cuota_manual")
  cuotaMensualEstimada   Float            @map("cuota_mensual_estimada")
  totalIntereses         Float            @map("total_intereses")
  totalPagar             Float            @map("total_pagar")
  estado                 EstadoCotizacion @default(BORRADOR)
  notas                  String?
  observaciones          String?
  fechaValidez           DateTime?        @map("fecha_validez")
  creadoEn               DateTime         @default(now()) @map("creado_en")
  actualizadoEn          DateTime         @updatedAt @map("actualizado_en")
  lead                   Lead?            @relation(fields: [idLead], references: [id], onDelete: Cascade)
  cliente                Cliente?         @relation(fields: [idCliente], references: [id], onDelete: Cascade)

  @@index([idLead])
  @@index([idCliente])
  @@index([estado])
  @@index([tipoCuota])
  @@map("cotizaciones")
}

model Reporte {
  id                String   @id @default(uuid())
  tipo              String
  parametros        Json?
  resultadosResumen Json?    @map("resultados_resumen")
  generadoPor       String?  @map("generado_por")
  generadoEn        DateTime @default(now()) @map("generado_en")
  usuario           Usuario? @relation("UsuarioReportes", fields: [generadoPor], references: [id])

  @@index([generadoPor])
  @@map("reportes")
}

model Proyecto {
  id              String             @id @default(uuid())
  nombre          String
  descripcion     String?            @db.Text
  imagen          String?
  precio          Float?
  ubicacion       String?
  latitud         Float?
  longitud        Float?
  estado          EstadoProyecto     @default(DISPONIBLE)
  activo          Boolean            @default(true)
  tipoProyecto    TipoProyecto?      @map("tipo_proyecto")
  categoria       String?
  galeria         Json?
  caracteristicas Json?
  mostrarEnWeb    Boolean            @default(true) @map("mostrar_en_web")
  ordenWeb        Int?               @map("orden_web")
  creadoEn        DateTime           @default(now()) @map("creado_en")
  actualizadoEn   DateTime           @updatedAt @map("actualizado_en")
  idUsuario       String             @map("id_usuario")
  clientes        ProyectoCliente[]
  etiquetas       ProyectoEtiqueta[]
  usuario         Usuario            @relation(fields: [idUsuario], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([idUsuario])
  @@index([tipoProyecto])
  @@index([mostrarEnWeb])
  @@map("proyectos")
}

// ==================== MODELO PARA ALERTAS DE LEADS ====================
model AlertaLead {
  id           String    @id @default(uuid())
  idLead       String?   @map("id_lead")
  idUsuario    String    @map("id_usuario")
  fechaCreada  DateTime  @default(now()) @map("fecha_creada")
  fechaLimite  DateTime  @map("fecha_limite") // 24 horas desde creación
  completada   Boolean   @default(false)
  completadaEn DateTime? @map("completada_en")
  notas        String?   @db.Text
  lead         Lead?     @relation(fields: [idLead], references: [id], onDelete: Cascade)
  usuario      Usuario   @relation(fields: [idUsuario], references: [id])

  @@index([idUsuario])
  @@index([idLead])
  @@index([completada])
  @@index([fechaLimite])
  @@index([fechaCreada])
  @@map("alertas_leads")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoCuota {
  FIJA
  FLEXIBLE
  FLEXIBLE_ESPECIAL
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum EstadoProyecto {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CONSTRUCCION
  FINALIZADO
}

enum TipoProyecto {
  TECHO_PROPIO       @map("techo_propio")
  CREDITO_MIVIVIENDA @map("credito_mivivienda")
  HABILITACIONES     @map("habilitaciones")
  COMPRA             @map("compra")
  VENTA              @map("venta")
  ALQUILER           @map("alquiler")
  DEPARTAMENTO       @map("departamento")
  CASA               @map("casa")
  TERRENO            @map("terreno")
  LOCAL_COMERCIAL    @map("local_comercial")
}

// ==================== MODELOS PARA PANEL ADMIN WEB (PHP) ====================
// Estos modelos mapean a tablas legacy del sitio PHP

enum TipoServicio {
  GENERAL    @map("general")
  TOPOGRAFIA @map("topografia")
  DRON       @map("dron")
}

enum EstadoTestimonio {
  PENDIENTE @map("pendiente")
  APROBADO  @map("aprobado")
  RECHAZADO @map("rechazado")
}

// Otros servicios para el sitio web
model OtrosServicios {
  id            Int          @id @default(autoincrement())
  titulo        String       @map("titulo")
  descripcion   String?      @map("descripcion")
  enlaceImagen  String?      @map("enlace_imagen")
  enlaceVideo   String?      @map("enlace_video")
  tipoServicio  TipoServicio @default(GENERAL) @map("tipo_servicio")
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  @@map("otros_servicios")
}

// Miembros del equipo para el sitio web
model MiembroEquipo {
  id            Int       @id @default(autoincrement())
  nombre        String
  cargo         String
  descripcion   String
  correo        String
  telefono      String
  foto          String?
  activo        Boolean   @default(true)
  ordenMostrar  Int       @map("orden_mostrar")
  facebook      String?
  instagram     String?
  tiktok        String?
  creadoEn      DateTime  @default(now()) @map("creado_en")
  actualizadoEn DateTime? @updatedAt @map("actualizado_en")

  @@index([activo])
  @@index([ordenMostrar])
  @@map("miembros_equipo")
}

// Testimonios para el sitio web
model Testimonio {
  id           Int              @id @default(autoincrement())
  nombre       String
  correo       String
  calificacion Int
  testimonio   String
  foto         String?
  media        String?
  videoUrl     String?          @map("video_url")
  estado       EstadoTestimonio @default(APROBADO)
  creadoEn     DateTime         @map("creado_en")
  aprobadoEn   DateTime?        @map("aprobado_en")

  @@index([estado])
  @@map("testimonios")
}

// Páginas de servicios para el sitio web (Techo Propio, Crédito, etc.)
model PaginaServicio {
  id               String       @id @default(uuid())
  tipoServicio     TipoProyecto @map("tipo_servicio")
  titulo           String
  subtitulo        String?
  descripcionCorta String?      @map("descripcion_corta")
  descripcionLarga String?      @map("descripcion_larga")
  imagenBanner     String?      @map("imagen_banner")
  videoBanner      String?      @map("video_banner")
  requisitos       Json?
  beneficios       Json?
  pasos            Json?
  preguntas        Json?
  activo           Boolean      @default(true)
  ordenMostrar     Int          @default(0) @map("orden_mostrar")
  metaTitle        String?      @map("meta_title")
  metaDescription  String?      @map("meta_description")
  creadoEn         DateTime     @default(now()) @map("creado_en")
  actualizadoEn    DateTime     @updatedAt @map("actualizado_en")

  @@unique([tipoServicio])
  @@index([activo])
  @@index([ordenMostrar])
  @@map("paginas_servicios")
}

// ==================== MODELOS PARA PORTAL DE CLIENTES ====================

// Contraseñas para acceso web de clientes
model ClientePassword {
  contactoId    String   @id @map("contacto_id")
  passwordWeb   String   @map("password_web")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")
  activo        Boolean  @default(true)

  @@map("cliente_passwords")
}

// Documentos subidos por clientes
model ClienteDocumento {
  id             String    @id @default(uuid())
  contactoId     String    @map("contacto_id")
  nombreArchivo  String    @map("nombre_archivo")
  nombreOriginal String    @map("nombre_original")
  rutaArchivo    String    @map("ruta_archivo")
  tipoDocumento  String    @map("tipo_documento")
  descripcion    String?
  mimeType       String    @map("mime_type")
  estado         String    @default("PENDIENTE")
  notas          String?
  subidoEn       DateTime  @default(now()) @map("subido_en")
  revisadoPor    String?   @map("revisado_por")
  revisadoEn     DateTime? @map("revisado_en")

  @@index([contactoId])
  @@index([estado])
  @@index([subidoEn])
  @@map("cliente_documentos")
}

// Registro de accesos al portal
model ClienteAcceso {
  id          String   @id @default(uuid())
  contactoId  String   @map("contacto_id")
  fechaAcceso DateTime @default(now()) @map("fecha_acceso")
  ipAddress   String   @map("ip_address")
  userAgent   String?  @map("user_agent")

  @@index([contactoId])
  @@index([fechaAcceso])
  @@map("cliente_accesos")
}

// Actividades del cliente en el portal
model ClienteActividad {
  id          String   @id @default(uuid())
  contactoId  String   @map("contacto_id")
  tipo        String
  descripcion String
  fecha       DateTime @default(now())
  metadata    Json?

  @@index([contactoId])
  @@index([fecha])
  @@map("cliente_actividades")
}
