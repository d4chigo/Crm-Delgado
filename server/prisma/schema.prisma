// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELO DE USUARIO
// ============================================

model Usuario {
  id        String   @id @default(uuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol      @default(AGENTE)
  avatar    String?
  telefono  String?
  activo    Boolean  @default(true)
  creadoEn  DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  // Relaciones
  contactos Contacto[]

  @@map("usuarios")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

// ============================================
// MODELO DE CONTACTO
// ============================================

model Contacto {
  id              String       @id @default(uuid())
  nombre          String
  apellido        String
  correo          String       @unique
  telefono        String?
  direccion       String?
  ciudad          String?
  dni             String?      @unique
  sexo            Sexo?
  fechaNacimiento DateTime?
  tipo            TipoContacto @default(CONTACTO)
  creadoEn        DateTime     @default(now())
  actualizadoEn   DateTime     @updatedAt

  // Relación con usuario que lo creó
  usuarioId String
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@map("contactos")
  @@index([usuarioId])
  @@index([tipo])
  @@index([correo])
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

enum TipoContacto {
  CONTACTO
  LEAD
  CLIENTE
}
