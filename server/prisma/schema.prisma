generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "mysql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model Usuario {
  id            String               @id @default(uuid())
  nombre        String
  email         String               @unique
  password      String
  rol           Rol                  @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  contactos     Contacto[]
  oportunidades OportunidadCliente[]
  proyectos     Proyecto[]
  reportes      Reporte[]            @relation("UsuarioReportes")

  @@map("usuarios")
}

model Contacto {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?
  tipo              TipoContacto         @default(CONTACTO)
  creadoEn          DateTime             @default(now())
  actualizadoEn     DateTime             @updatedAt
  usuarioId         String
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  estadoLead        EstadoLead?
  fechaConversion   DateTime?
  fechaSeguimiento  DateTime?
  fuente            String?
  intereses         String?              @db.Text
  notas             String?              @db.Text
  presupuesto       Decimal?             @db.Decimal(10, 2)
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetas         ContactoEtiqueta[]
  usuario           Usuario              @relation(fields: [usuarioId], references: [id])
  cotizaciones      Cotizacion[]
  clientesAsociados LeadCliente[]        @relation("ClienteRelacion")
  leadsAsociados    LeadCliente[]        @relation("LeadRelacion")
  oportunidades     OportunidadCliente[]
  proyectos         ProyectoCliente[]

  @@index([usuarioId])
  @@index([tipo])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([estadoLead])
  @@index([prioridad])
  @@map("contactos")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  contactos     ContactoEtiqueta[]
  proyectos     ProyectoEtiqueta[]

  @@index([activa])
  @@index([activa, orden])
  @@map("etiquetas")
}

model ContactoEtiqueta {
  contactoId String
  etiquetaId String
  asignadoEn DateTime @default(now())
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([contactoId, etiquetaId])
  @@index([contactoId])
  @@index([etiquetaId])
  @@map("contacto_etiquetas")
}

model LeadCliente {
  leadId     String
  clienteId  String
  asociadoEn DateTime @default(now())
  notas      String?  @db.Text
  estado     String?  @db.VarChar(50)
  cliente    Contacto @relation("ClienteRelacion", fields: [clienteId], references: [id], onDelete: Cascade)
  lead       Contacto @relation("LeadRelacion", fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, clienteId])
  @@index([leadId])
  @@index([clienteId])
  @@map("lead_clientes")
}

model OportunidadCliente {
  id              String        @id @default(uuid())
  clienteId       String
  titulo          String
  proyecto        String?
  propiedad       String?
  etapa           EtapaPipeline @default(LEAD)
  valor           Decimal?      @db.Decimal(12, 2)
  probabilidad    Int?          @default(25)
  proximaAccion   String?       @db.Text
  ultimaActividad DateTime      @default(now())
  notas           String?       @db.Text
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt
  usuarioId       String
  cliente         Contacto      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([clienteId])
  @@index([usuarioId])
  @@index([etapa])
  @@index([creadoEn])
  @@map("oportunidades_clientes")
}

model ProyectoEtiqueta {
  proyectoId String
  etiquetaId String
  asignadoEn DateTime  @default(now())
  etiqueta   Etiqueta  @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, etiquetaId])
  @@index([proyectoId])
  @@index([etiquetaId])
  @@map("proyecto_etiquetas")
}

model ProyectoCliente {
  proyectoId String
  clienteId  String
  asociadoEn DateTime  @default(now())
  notas      String?   @db.Text
  cliente    Contacto  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, clienteId])
  @@index([proyectoId])
  @@index([clienteId])
  @@map("proyecto_clientes")
}

model Cotizacion {
  id                     String           @id @default(uuid())
  contactoId             String
  numeroReferencia       String           @unique
  nombreProyecto         String
  tipoInmueble           String?
  descripcion            String?          @db.Text
  precioInmueble         Decimal          @db.Decimal(12, 2)
  cuotaInicial           Decimal          @db.Decimal(12, 2)
  porcentajeCuotaInicial Decimal          @db.Decimal(5, 2)
  montoFinanciar         Decimal          @db.Decimal(12, 2)
  plazoMeses             Int
  tipoCuota              TipoCuota        @default(FIJA)
  tasaInteresAnual       Decimal          @db.Decimal(5, 2)
  permitePostergar       Boolean          @default(false)
  cuotasPostergables     Int?
  permiteDoble           Boolean          @default(false)
  cuotasDoblesAnuales    Int?
  permiteCambioFecha     Boolean          @default(false)
  montoCuotaManual       Decimal?         @db.Decimal(12, 2)
  cuotaMensualEstimada   Decimal          @db.Decimal(12, 2)
  totalIntereses         Decimal          @db.Decimal(12, 2)
  totalPagar             Decimal          @db.Decimal(12, 2)
  estado                 EstadoCotizacion @default(BORRADOR)
  notas                  String?          @db.Text
  observaciones          String?          @db.Text
  fechaValidez           DateTime?
  creadoEn               DateTime         @default(now())
  actualizadoEn          DateTime         @updatedAt
  contacto               Contacto         @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  @@index([contactoId])
  @@index([estado])
  @@index([tipoCuota])
  @@map("cotizaciones")
}

model Reporte {
  id                String   @id @default(uuid())
  tipo              String
  parametros        Json?
  resultadosResumen Json?
  generadoPor       String?
  generadoEn        DateTime @default(now())
  usuario           Usuario? @relation("UsuarioReportes", fields: [generadoPor], references: [id])

  @@index([generadoPor])
  @@map("reportes")
}

model Proyecto {
  id            String             @id @default(uuid())
  nombre        String
  descripcion   String?            @db.Text
  imagen        String?
  precio        Decimal?           @db.Decimal(12, 2)
  ubicacion     String?
  estado        EstadoProyecto     @default(DISPONIBLE)
  activo        Boolean            @default(true)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  usuarioId     String
  clientes      ProyectoCliente[]
  etiquetas     ProyectoEtiqueta[]
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([usuarioId])
  @@map("proyectos")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum TipoContacto {
  CONTACTO
  LEAD
  CLIENTE
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum EtapaPipeline {
  LEAD
  CONTACTO
  VISITA
  NEGOCIACION
  CIERRE
  GANADO
  PERDIDO
}

enum TipoCuota {
  FIJA
  FLEXIBLE
  FLEXIBLE_ESPECIAL
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum EstadoProyecto {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CONSTRUCCION
  FINALIZADO
}

// ==================== MODELOS PARA PANEL ADMIN WEB (PHP) ====================
// Estos modelos mapean a tablas legacy del sitio PHP

enum TipoServicio {
  GENERAL    @map("general")
  TOPOGRAFIA @map("topografia")
  DRON       @map("dron")
}

enum EstadoTestimonio {
  PENDIENTE @map("pending")
  APROBADO  @map("approved")
  RECHAZADO @map("rejected")
}

// Otros servicios para el sitio web
model OtrosServicios {
  id             Int          @id @default(autoincrement())
  titulo         String       @db.VarChar(255)
  descripcion    String?      @db.Text
  enlaceImagen   String?      @map("image_link") @db.VarChar(512)
  enlaceVideo    String?      @map("video_link") @db.VarChar(512)
  tipoServicio   TipoServicio @map("service_type") @default(GENERAL)
  creadoEn       DateTime     @default(now()) @map("created_at")
  actualizadoEn  DateTime     @updatedAt @map("updated_at")

  @@map("otros_servicios")
}

// Miembros del equipo para el sitio web
model MiembroEquipo {
  id             Int       @id @default(autoincrement())
  nombre         String    @db.VarChar(100)
  cargo          String    @db.VarChar(100)
  descripcion    String    @db.Text
  correo         String    @db.VarChar(100)
  telefono       String    @db.VarChar(20)
  foto           String?   @db.VarChar(255)
  activo         Boolean   @default(true)
  ordenMostrar   Int       @map("display_order")
  facebook       String?   @db.VarChar(255)
  instagram      String?   @db.VarChar(255)
  tiktok         String?   @db.VarChar(255)
  creadoEn       DateTime  @default(now()) @map("created_at")
  actualizadoEn  DateTime? @updatedAt @map("updated_at")

  @@index([activo])
  @@index([ordenMostrar])
  @@map("team_members")
}

// Testimonios para el sitio web
model Testimonio {
  id             Int              @id @default(autoincrement())
  nombre         String           @db.VarChar(100)
  correo         String           @db.VarChar(100)
  calificacion   Int
  testimonio     String           @db.Text
  foto           String?          @db.VarChar(255)
  media          String?          @db.VarChar(255)
  videoUrl       String?          @map("video_url") @db.VarChar(255)
  estado         EstadoTestimonio @default(APROBADO)
  creadoEn       DateTime         @map("created_at")
  aprobadoEn     DateTime?        @map("approved_at")

  @@index([estado])
  @@map("testimonials")
}

// ==================== MODELOS PARA PORTAL DE CLIENTES ====================

// Contraseñas para acceso web de clientes
model ClientePassword {
  contactoId    String   @id @map("contacto_id")
  passwordWeb   String   @map("password_web") @db.VarChar(255)
  creadoEn      DateTime @default(now()) @map("created_at")
  actualizadoEn DateTime @updatedAt @map("updated_at")

  @@map("cliente_passwords")
}

// Documentos subidos por clientes
model ClienteDocumento {
  id              String   @id @default(uuid())
  contactoId      String   @map("contacto_id")
  nombreArchivo   String   @map("nombre_archivo") @db.VarChar(255)
  nombreOriginal  String   @map("nombre_original") @db.VarChar(255)
  rutaArchivo     String   @map("ruta_archivo") @db.VarChar(512)
  tipoDocumento   String   @map("tipo_documento") @db.VarChar(50)
  descripcion     String?  @db.Text
  tamanoBytes     Int      @map("tamano_bytes")
  mimeType        String   @map("mime_type") @db.VarChar(100)
  subidoEn        DateTime @default(now()) @map("subido_en")
  estado          String   @default("PENDIENTE") @db.VarChar(50)
  revisadoPor     String?  @map("revisado_por")
  revisadoEn      DateTime? @map("revisado_en")
  notas           String?  @db.Text

  @@index([contactoId])
  @@index([estado])
  @@index([subidoEn])
  @@map("cliente_documentos")
}

// Registro de accesos al portal
model ClienteAcceso {
  id             String   @id @default(uuid())
  contactoId     String   @map("contacto_id")
  fechaAcceso    DateTime @default(now()) @map("fecha_acceso")
  ipAddress      String   @map("ip_address") @db.VarChar(45)
  userAgent      String?  @map("user_agent") @db.Text

  @@index([contactoId])
  @@index([fechaAcceso])
  @@map("cliente_accesos")
}

// Actividades del cliente en el portal
model ClienteActividad {
  id          String   @id @default(uuid())
  contactoId  String   @map("contacto_id")
  tipo        String   @db.VarChar(50)
  descripcion String   @db.Text
  fecha       DateTime @default(now())
  metadata    Json?

  @@index([contactoId])
  @@index([fecha])
  @@map("cliente_actividades")
}
