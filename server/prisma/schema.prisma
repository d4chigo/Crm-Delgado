generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String               @id @default(uuid())
  nombre        String
  correo        String               @unique
  contrasena    String
  rol           Rol                  @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  leads         Lead[]
  clientes      Cliente[]
  oportunidades OportunidadCliente[]
  proyectos     Proyecto[]
  reportes      Reporte[]            @relation("UsuarioReportes")
  alertas       AlertaLead[]

  @@map("usuarios")
}

model Lead {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fecha_nacimiento  DateTime?
  creado_en         DateTime             @default(now())
  actualizado_en    DateTime             @updatedAt
  id_usuario        String
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  estado            EstadoLead?          @default(NUEVO)
  fecha_seguimiento DateTime?
  fuente            String?
  etiquetas         String?
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      LeadEtiqueta[]
  usuario           Usuario              @relation(fields: [id_usuario], references: [id])
  oportunidades     OportunidadCliente[]
  clientesAsociados LeadClienteAsociacion[] @relation("LeadRelacion")
  alertas           AlertaLead[]
  cotizaciones      Cotizacion[]

  @@index([id_usuario])
  @@index([correo])
  @@index([creado_en])
  @@index([departamento])
  @@index([estado])
  @@index([prioridad])
  @@map("leads")
}

model Cliente {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fecha_nacimiento  DateTime?
  creado_en         DateTime             @default(now())
  actualizado_en    DateTime             @updatedAt
  id_usuario        String
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  fecha_conversion  DateTime?
  fecha_seguimiento DateTime?
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      ClienteEtiqueta[]
  usuario           Usuario              @relation(fields: [id_usuario], references: [id])
  cotizaciones      Cotizacion[]
  oportunidades     OportunidadCliente[]
  proyectos         ProyectoCliente[]
  leadsAsociados    LeadClienteAsociacion[] @relation("ClienteRelacion")

  @@index([id_usuario])
  @@index([correo])
  @@index([creado_en])
  @@index([departamento])
  @@index([prioridad])
  @@map("clientes")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creado_en     DateTime           @default(now())
  actualizado_en DateTime          @updatedAt
  leads         LeadEtiqueta[]
  clientes      ClienteEtiqueta[]
  proyectos     ProyectoEtiqueta[]

  @@index([activa])
  @@index([activa, orden])
  @@map("etiquetas")
}

model LeadEtiqueta {
  id_lead    String
  id_etiqueta String
  asignado_en DateTime @default(now())
  lead       Lead     @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [id_etiqueta], references: [id], onDelete: Cascade)

  @@id([id_lead, id_etiqueta])
  @@index([id_lead])
  @@index([id_etiqueta])
  @@map("lead_etiquetas")
}

model ClienteEtiqueta {
  id_cliente  String
  id_etiqueta String
  asignado_en DateTime @default(now())
  cliente     Cliente  @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  etiqueta    Etiqueta @relation(fields: [id_etiqueta], references: [id], onDelete: Cascade)

  @@id([id_cliente, id_etiqueta])
  @@index([id_cliente])
  @@index([id_etiqueta])
  @@map("cliente_etiquetas")
}

model LeadClienteAsociacion {
  id_lead    String
  id_cliente String
  asociado_en DateTime @default(now())
  notas      String?
  estado     String?
  cliente    Cliente  @relation("ClienteRelacion", fields: [id_cliente], references: [id], onDelete: Cascade)
  lead       Lead     @relation("LeadRelacion", fields: [id_lead], references: [id], onDelete: Cascade)

  @@id([id_lead, id_cliente])
  @@index([id_lead])
  @@index([id_cliente])
  @@map("lead_cliente_asociaciones")
}

model OportunidadCliente {
  id              String        @id @default(uuid())
  id_lead         String?
  id_cliente      String?
  titulo          String
  proyecto        String?
  propiedad       String?
  etapa           String        @default("CONTACTO_INICIAL")
  valor           Float?
  probabilidad    Int?          @default(25)
  proxima_accion  String?
  ultima_actividad DateTime     @default(now())
  notas           String?
  creado_en       DateTime      @default(now())
  actualizado_en  DateTime      @updatedAt
  id_usuario      String
  lead            Lead?         @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  cliente         Cliente?      @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [id_usuario], references: [id])

  @@index([id_lead])
  @@index([id_cliente])
  @@index([id_usuario])
  @@index([etapa])
  @@index([creado_en])
  @@map("oportunidades_clientes")
}

model HistorialPipelineLead {
  id                    String        @id @default(uuid())
  id_oportunidad        String
  id_lead               String
  etapa_anterior        String
  etapa_nueva           String
  probabilidad_anterior Int?
  probabilidad_nueva    Int?
  valor_anterior        Float?
  valor_nuevo           Float?
  cambiado_en           DateTime      @default(now())
  cambiado_por          String
  notas                 String?       @db.Text
  razon                 String?

  @@index([id_oportunidad])
  @@index([id_lead])
  @@index([cambiado_por])
  @@index([cambiado_en])
  @@index([etapa_nueva])
  @@map("historial_etapas_leads")
}

model ProyectoEtiqueta {
  id_proyecto String
  id_etiqueta String
  asignado_en DateTime  @default(now())
  etiqueta    Etiqueta  @relation(fields: [id_etiqueta], references: [id], onDelete: Cascade)
  proyecto    Proyecto  @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@id([id_proyecto, id_etiqueta])
  @@index([id_proyecto])
  @@index([id_etiqueta])
  @@map("etiquetas_proyectos")
}

model ProyectoCliente {
  id_proyecto String
  id_cliente  String
  asociado_en DateTime  @default(now())
  notas       String?
  cliente     Cliente   @relation(fields: [id_cliente], references: [id], onDelete: Cascade)
  proyecto    Proyecto  @relation(fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@id([id_proyecto, id_cliente])
  @@index([id_proyecto])
  @@index([id_cliente])
  @@map("clientes_proyectos")
}

model ProyectoContacto {
  id_proyecto String
  id_contacto String
  tipo_contacto String // 'CLIENTE' o 'LEAD'
  asociado_en DateTime  @default(now())
  notas       String?
  proyecto    Proyecto @relation("ProyectoContactos", fields: [id_proyecto], references: [id], onDelete: Cascade)

  @@id([id_proyecto, id_contacto])
  @@index([id_proyecto])
  @@index([id_contacto])
  @@map("contactos_proyectos")
}

model Cotizacion {
  id                     String           @id @default(uuid())
  id_lead                String?
  id_cliente             String?
  numero_referencia      String           @unique
  nombre_proyecto        String
  tipo_inmueble          String?
  descripcion            String?
  precio_inmueble        Float
  cuota_inicial          Float
  porcentaje_cuota_inicial Float
  monto_financiar        Float
  plazo_meses            Int
  tipo_cuota             TipoCuota        @default(FIJA)
  tasa_interes_anual     Float
  permite_postergar      Boolean          @default(false)
  cuotas_postergables    Int?
  permite_doble          Boolean          @default(false)
  cuotas_dobles_anuales  Int?
  permite_cambio_fecha   Boolean          @default(false)
  monto_cuota_manual     Float?
  cuota_mensual_estimada Float
  total_intereses        Float
  total_pagar            Float
  estado                 EstadoCotizacion @default(BORRADOR)
  notas                  String?
  observaciones          String?
  fecha_validez          DateTime?
  creado_en              DateTime         @default(now())
  actualizado_en         DateTime         @updatedAt
  lead                   Lead?            @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  cliente                Cliente?         @relation(fields: [id_cliente], references: [id], onDelete: Cascade)

  @@index([id_lead])
  @@index([id_cliente])
  @@index([estado])
  @@index([tipo_cuota])
  @@map("cotizaciones")
}

model Reporte {
  id                String   @id @default(uuid())
  tipo              String
  parametros        Json?
  resultados_resumen Json?
  generado_por      String?
  generado_en       DateTime @default(now())
  usuario           Usuario? @relation("UsuarioReportes", fields: [generado_por], references: [id])

  @@index([generado_por])
  @@map("reportes")
}

model Notificacion {
  id            String   @id @default(uuid())
  titulo        String
  descripcion   String   @db.Text
  tipo          String   @default("INFO")
  leida         Boolean  @default(false)
  id_usuario    String?
  id_contacto   String?
  referencia    String?  // ID del recurso relacionado (lead, contacto, etc)
  tipo_referencia String?  // Tipo de recurso (LEAD, CONTACTO, OPORTUNIDAD, etc)
  creado_en     DateTime @default(now())
  leida_en      DateTime?

  @@index([id_usuario])
  @@index([id_contacto])
  @@index([leida])
  @@index([creado_en])
  @@index([tipo_referencia])
  @@map("notificaciones")
}

model Proyecto {
  id            String             @id @default(uuid())
  nombre        String
  descripcion   String?            @db.Text
  imagen        String?
  precio        Float?
  ubicacion     String?
  latitud       Float?
  longitud      Float?
  estado        EstadoProyecto     @default(DISPONIBLE)
  activo        Boolean            @default(true)
  tipo_proyecto TipoProyecto?
  categoria     String?
  galeria       Json?
  caracteristicas Json?
  mostrar_en_web Boolean           @default(true)
  orden_web     Int?
  creado_en     DateTime           @default(now())
  actualizado_en DateTime          @updatedAt
  id_usuario    String
  clientes      ProyectoCliente[]
  contactos     ProyectoContacto[] @relation("ProyectoContactos")
  etiquetas     ProyectoEtiqueta[]
  usuario       Usuario            @relation(fields: [id_usuario], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([id_usuario])
  @@index([tipo_proyecto])
  @@index([mostrar_en_web])
  @@map("proyectos")
}

// ==================== MODELO PARA ALERTAS DE LEADS ====================
model AlertaLead {
  id            String           @id @default(uuid())
  id_lead       String?
  id_usuario    String
  fecha_creada  DateTime         @default(now())
  fecha_limite  DateTime         // 24 horas desde creación
  completada    Boolean          @default(false)
  completada_en DateTime?
  notas         String?          @db.Text
  lead          Lead?            @relation(fields: [id_lead], references: [id], onDelete: Cascade)
  usuario       Usuario          @relation(fields: [id_usuario], references: [id])

  @@index([id_usuario])
  @@index([id_lead])
  @@index([completada])
  @@index([fecha_limite])
  @@index([fecha_creada])
  @@map("alertas_leads")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoCuota {
  FIJA
  FLEXIBLE
  FLEXIBLE_ESPECIAL
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum EstadoProyecto {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CONSTRUCCION
  FINALIZADO
}

enum TipoProyecto {
  TECHO_PROPIO       @map("techo_propio")
  CREDITO_MIVIVIENDA @map("credito_mivivienda")
  HABILITACIONES     @map("habilitaciones")
  COMPRA             @map("compra")
  VENTA              @map("venta")
  ALQUILER           @map("alquiler")
  DEPARTAMENTO       @map("departamento")
  CASA               @map("casa")
  TERRENO            @map("terreno")
  LOCAL_COMERCIAL    @map("local_comercial")
}

// ==================== MODELOS PARA PANEL ADMIN WEB (PHP) ====================
// Estos modelos mapean a tablas legacy del sitio PHP

enum TipoServicio {
  GENERAL    @map("general")
  TOPOGRAFIA @map("topografia")
  DRON       @map("dron")
}

enum EstadoTestimonio {
  PENDIENTE @map("pendiente")
  APROBADO  @map("aprobado")
  RECHAZADO @map("rechazado")
}

// Otros servicios para el sitio web
model OtrosServicios {
  id               Int          @id @default(autoincrement())
  titulo           String
  descripcion      String?
  caracteristicas  String?      @db.LongText  // JSON array as string
  imagenes         String?      @db.LongText  // JSON array as string
  enlace_imagen    String?
  enlace_video     String?
  tipo_servicio    TipoServicio @default(GENERAL)
  creado_en        DateTime     @default(now())
  actualizado_en   DateTime     @updatedAt

  @@map("servicios_adicionales")
}

// Miembros del equipo para el sitio web
model MiembroEquipo {
  id             Int       @id @default(autoincrement())
  nombre         String
  cargo          String
  descripcion    String    @db.LongText
  correo         String
  telefono       String
  foto           String?   @db.LongText
  activo         Boolean   @default(true)
  orden_mostrar  Int
  facebook       String?
  instagram      String?
  tiktok         String?
  creado_en      DateTime  @default(now())
  actualizado_en DateTime? @updatedAt

  @@index([activo])
  @@index([orden_mostrar])
  @@map("miembros_equipo")
}

// Testimonios para el sitio web
model Testimonio {
  id             Int              @id @default(autoincrement())
  nombre         String
  correo         String
  calificacion   Int
  testimonio     String           @db.Text
  foto           String?
  media          String?
  video_url      String?
  estado         EstadoTestimonio @default(APROBADO)
  creado_en      DateTime
  aprobado_en    DateTime?

  @@index([estado])
  @@map("testimonios")
}

// Páginas de servicios para el sitio web (Techo Propio, Crédito, etc.)
model PaginaServicio {
  id                String    @id @default(uuid())
  tipo_servicio     TipoProyecto
  titulo            String
  subtitulo         String?
  descripcion_corta String?
  descripcion_larga String?
  imagen_banner     String?
  video_banner      String?
  requisitos        Json?
  beneficios        Json?
  pasos             Json?
  preguntas         Json?
  activo            Boolean   @default(true)
  orden_mostrar     Int       @default(0)
  meta_title        String?
  meta_description  String?
  creado_en         DateTime  @default(now())
  actualizado_en    DateTime  @updatedAt

  @@unique([tipo_servicio])
  @@index([activo])
  @@index([orden_mostrar])
  @@map("paginas_servicios")
}

// ==================== MODELOS PARA PORTAL DE CLIENTES ====================

// Contraseñas para acceso web de clientes
model ClientePassword {
  id_contacto   String   @id
  contrasena_web String
  activo        Boolean  @default(true)
  creado_en     DateTime @default(now())
  actualizado_en DateTime @updatedAt

  @@map("contrasenas_clientes")
}

// Documentos subidos por clientes
model ClienteDocumento {
  id              String   @id @default(uuid())
  id_contacto     String
  nombre_archivo  String
  nombre_original String
  ruta_archivo    String
  tipo_documento  String
  descripcion     String?
  tamano_bytes    Int
  mime_type       String
  subido_en       DateTime @default(now())
  estado          String   @default("PENDIENTE")
  revisado_por    String?
  revisado_en     DateTime?
  notas           String?

  @@index([id_contacto])
  @@index([estado])
  @@index([subido_en])
  @@map("documentos_clientes")
}

// Registro de accesos al portal
model ClienteAcceso {
  id             String   @id @default(uuid())
  id_contacto    String
  fecha_acceso   DateTime @default(now())
  ip_address     String
  user_agent     String?

  @@index([id_contacto])
  @@index([fecha_acceso])
  @@map("accesos_clientes")
}

// Actividades del cliente en el portal
model ClienteActividad {
  id          String   @id @default(uuid())
  id_contacto String
  tipo        String
  descripcion String
  fecha       DateTime @default(now())
  metadata    Json?

  @@index([id_contacto])
  @@index([fecha])
  @@map("actividades_clientes")
}
