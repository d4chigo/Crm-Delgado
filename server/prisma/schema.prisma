generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String               @id @default(uuid())
  nombre        String
  email         String               @unique
  password      String
  rol           Rol                  @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean              @default(true)
  creadoEn      DateTime             @default(now())
  actualizadoEn DateTime             @updatedAt
  leads         Lead[]
  clientes      Cliente[]
  oportunidades OportunidadCliente[]
  proyectos     Proyecto[]
  reportes      Reporte[]            @relation("UsuarioReportes")
  alertas       AlertaLead[]

  @@map("usuarios")
}

model Lead {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?
  creadoEn          DateTime             @default(now())
  actualizadoEn     DateTime             @updatedAt
  usuarioId         String
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  estado            EstadoLead?          @default(NUEVO)
  fechaSeguimiento  DateTime?
  fuente            String?
  etiquetas         String?
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      LeadEtiqueta[]
  usuario           Usuario              @relation(fields: [usuarioId], references: [id])
  oportunidades     OportunidadCliente[]
  clientesAsociados LeadClienteAsociacion[] @relation("LeadRelacion")
  alertas           AlertaLead[]

  @@index([usuarioId])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([estado])
  @@index([prioridad])
  @@map("leads")
}

model Cliente {
  id                String               @id @default(uuid())
  nombre            String
  apellido          String?
  correo            String?
  telefono          String?
  direccion         String?
  ciudad            String?
  dni               String?
  sexo              Sexo?
  fechaNacimiento   DateTime?
  creadoEn          DateTime             @default(now())
  actualizadoEn     DateTime             @updatedAt
  usuarioId         String
  cargo             String?
  departamento      String?
  distrito          String?
  empresa           String?
  fechaConversion   DateTime?
  fechaSeguimiento  DateTime?
  notas             String?
  presupuesto       Float?
  prioridad         Prioridad            @default(MEDIA)
  probabilidad      Int?
  provincia         String?
  etiquetasRel      ClienteEtiqueta[]
  usuario           Usuario              @relation(fields: [usuarioId], references: [id])
  cotizaciones      Cotizacion[]
  oportunidades     OportunidadCliente[]
  proyectos         ProyectoCliente[]
  leadsAsociados    LeadClienteAsociacion[] @relation("ClienteRelacion")

  @@index([usuarioId])
  @@index([correo])
  @@index([creadoEn])
  @@index([departamento])
  @@index([prioridad])
  @@map("clientes")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  leads         LeadEtiqueta[]
  clientes      ClienteEtiqueta[]
  proyectos     ProyectoEtiqueta[]

  @@index([activa])
  @@index([activa, orden])
  @@map("etiquetas")
}

model LeadEtiqueta {
  leadId     String
  etiquetaId String
  asignadoEn DateTime @default(now())
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([leadId, etiquetaId])
  @@index([leadId])
  @@index([etiquetaId])
  @@map("lead_etiquetas")
}

model ClienteEtiqueta {
  clienteId  String
  etiquetaId String
  asignadoEn DateTime @default(now())
  cliente    Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([clienteId, etiquetaId])
  @@index([clienteId])
  @@index([etiquetaId])
  @@map("cliente_etiquetas")
}

model LeadClienteAsociacion {
  leadId     String
  clienteId  String
  asociadoEn DateTime @default(now())
  notas      String?
  estado     String?
  cliente    Cliente  @relation("ClienteRelacion", fields: [clienteId], references: [id], onDelete: Cascade)
  lead       Lead     @relation("LeadRelacion", fields: [leadId], references: [id], onDelete: Cascade)

  @@id([leadId, clienteId])
  @@index([leadId])
  @@index([clienteId])
  @@map("lead_cliente_asociaciones")
}

model OportunidadCliente {
  id              String        @id @default(uuid())
  leadId          String?
  clienteId       String?
  titulo          String
  proyecto        String?
  propiedad       String?
  etapa           String        @default("CONTACTO_INICIAL")
  valor           Float?
  probabilidad    Int?          @default(25)
  proximaAccion   String?
  ultimaActividad DateTime      @default(now())
  notas           String?
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt
  usuarioId       String
  lead            Lead?         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  cliente         Cliente?      @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  usuario         Usuario       @relation(fields: [usuarioId], references: [id])

  @@index([leadId])
  @@index([clienteId])
  @@index([usuarioId])
  @@index([etapa])
  @@index([creadoEn])
  @@map("oportunidades_clientes")
}

model HistorialPipelineLead {
  id                    String        @id @default(uuid())
  oportunidadId         String
  leadId                String
  etapaAnterior         String
  etapaNueva            String
  probabilidadAnterior  Int?
  probabilidadNueva     Int?
  valorAnterior         Float?
  valorNuevo            Float?
  cambiadoEn            DateTime      @default(now())
  cambiadoPor           String
  notas                 String?       @db.Text
  razon                 String?

  @@index([oportunidadId])
  @@index([leadId])
  @@index([cambiadoPor])
  @@index([cambiadoEn])
  @@index([etapaNueva])
  @@map("historial_pipeline_leads")
}

model ProyectoEtiqueta {
  proyectoId String
  etiquetaId String
  asignadoEn DateTime  @default(now())
  etiqueta   Etiqueta  @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, etiquetaId])
  @@index([proyectoId])
  @@index([etiquetaId])
  @@map("proyecto_etiquetas")
}

model ProyectoCliente {
  proyectoId String
  clienteId  String
  asociadoEn DateTime  @default(now())
  notas      String?
  cliente    Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id], onDelete: Cascade)

  @@id([proyectoId, clienteId])
  @@index([proyectoId])
  @@index([clienteId])
  @@map("proyecto_clientes")
}

model Cotizacion {
  id                     String           @id @default(uuid())
  clienteId              String
  numeroReferencia       String           @unique
  nombreProyecto         String
  tipoInmueble           String?
  descripcion            String?
  precioInmueble         Float
  cuotaInicial           Float
  porcentajeCuotaInicial Float
  montoFinanciar         Float
  plazoMeses             Int
  tipoCuota              TipoCuota        @default(FIJA)
  tasaInteresAnual       Float
  permitePostergar       Boolean          @default(false)
  cuotasPostergables     Int?
  permiteDoble           Boolean          @default(false)
  cuotasDoblesAnuales    Int?
  permiteCambioFecha     Boolean          @default(false)
  montoCuotaManual       Float?
  cuotaMensualEstimada   Float
  totalIntereses         Float
  totalPagar             Float
  estado                 EstadoCotizacion @default(BORRADOR)
  notas                  String?
  observaciones          String?
  fechaValidez           DateTime?
  creadoEn               DateTime         @default(now())
  actualizadoEn          DateTime         @updatedAt
  cliente                Cliente          @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@index([clienteId])
  @@index([estado])
  @@index([tipoCuota])
  @@map("cotizaciones")
}

model Reporte {
  id                String   @id @default(uuid())
  tipo              String
  parametros        Json?
  resultadosResumen Json?
  generadoPor       String?
  generadoEn        DateTime @default(now())
  usuario           Usuario? @relation("UsuarioReportes", fields: [generadoPor], references: [id])

  @@index([generadoPor])
  @@map("reportes")
}

model Notificacion {
  id            String   @id @default(uuid())
  titulo        String
  descripcion   String   @db.Text
  tipo          String   @default("INFO")
  leida         Boolean  @default(false)
  usuarioId     String?
  contactoId    String?
  referencia    String?  // ID del recurso relacionado (lead, contacto, etc)
  tipoReferencia String?  // Tipo de recurso (LEAD, CONTACTO, OPORTUNIDAD, etc)
  creadoEn      DateTime @default(now())
  leidaEn       DateTime?

  @@index([usuarioId])
  @@index([contactoId])
  @@index([leida])
  @@index([creadoEn])
  @@index([tipoReferencia])
  @@map("notificaciones")
}

model Proyecto {
  id            String             @id @default(uuid())
  nombre        String
  descripcion   String?            @db.Text
  imagen        String?
  precio        Float?
  ubicacion     String?
  latitud       Float?
  longitud      Float?
  estado        EstadoProyecto     @default(DISPONIBLE)
  activo        Boolean            @default(true)
  tipoProyecto  TipoProyecto?      @map("tipo_proyecto")
  categoria     String?
  galeria       Json?
  caracteristicas Json?
  mostrarEnWeb  Boolean            @default(true) @map("mostrar_en_web")
  ordenWeb      Int?               @map("orden_web")
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  usuarioId     String
  clientes      ProyectoCliente[]
  etiquetas     ProyectoEtiqueta[]
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([activo])
  @@index([estado])
  @@index([usuarioId])
  @@index([tipoProyecto])
  @@index([mostrarEnWeb])
  @@map("proyectos")
}

// ==================== MODELO PARA ALERTAS DE LEADS ====================
model AlertaLead {
  id            String           @id @default(uuid())
  leadId        String?
  usuarioId     String
  fechaCreada   DateTime         @default(now())
  fechaLimite   DateTime         // 24 horas desde creación
  completada    Boolean          @default(false)
  completadaEn  DateTime?
  notas         String?          @db.Text
  lead          Lead?            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  usuario       Usuario          @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([leadId])
  @@index([completada])
  @@index([fechaLimite])
  @@index([fechaCreada])
  @@map("alertas_leads")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TipoCuota {
  FIJA
  FLEXIBLE
  FLEXIBLE_ESPECIAL
}

enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA
}

enum EstadoProyecto {
  DISPONIBLE
  RESERVADO
  VENDIDO
  CONSTRUCCION
  FINALIZADO
}

enum TipoProyecto {
  TECHO_PROPIO       @map("techo_propio")
  CREDITO_MIVIVIENDA @map("credito_mivivienda")
  HABILITACIONES     @map("habilitaciones")
  COMPRA             @map("compra")
  VENTA              @map("venta")
  ALQUILER           @map("alquiler")
  DEPARTAMENTO       @map("departamento")
  CASA               @map("casa")
  TERRENO            @map("terreno")
  LOCAL_COMERCIAL    @map("local_comercial")
}

// ==================== MODELOS PARA PANEL ADMIN WEB (PHP) ====================
// Estos modelos mapean a tablas legacy del sitio PHP

enum TipoServicio {
  GENERAL    @map("general")
  TOPOGRAFIA @map("topografia")
  DRON       @map("dron")
}

enum EstadoTestimonio {
  PENDIENTE @map("pending")
  APROBADO  @map("approved")
  RECHAZADO @map("rejected")
}

// Otros servicios para el sitio web
model OtrosServicios {
  id               Int          @id @default(autoincrement())
  titulo           String
  descripcion      String?
  caracteristicas  String?      @db.LongText  // JSON array as string
  imagenes         String?      @db.LongText  // JSON array as string
  enlaceImagen     String?      @map("image_link")
  enlaceVideo      String?      @map("video_link")
  tipoServicio     TipoServicio @map("service_type") @default(GENERAL)
  creadoEn         DateTime     @default(now()) @map("created_at")
  actualizadoEn    DateTime     @updatedAt @map("updated_at")

  @@map("otros_servicios")
}

// Miembros del equipo para el sitio web
model MiembroEquipo {
  id             Int       @id @default(autoincrement())
  nombre         String
  cargo          String
  descripcion    String    @db.LongText
  correo         String
  telefono       String
  foto           String?   @db.LongText
  activo         Boolean   @default(true)
  ordenMostrar   Int       @map("display_order")
  facebook       String?
  instagram      String?
  tiktok         String?
  creadoEn       DateTime  @default(now()) @map("created_at")
  actualizadoEn  DateTime? @updatedAt @map("updated_at")

  @@index([activo])
  @@index([ordenMostrar])
  @@map("team_members")
}

// Testimonios para el sitio web
model Testimonio {
  id             Int              @id @default(autoincrement())
  nombre         String
  correo         String
  calificacion   Int
  testimonio     String           @db.Text
  foto           String?
  media          String?
  videoUrl       String?          @map("video_url")
  estado         EstadoTestimonio @default(APROBADO)
  creadoEn       DateTime         @map("created_at")
  aprobadoEn     DateTime?        @map("approved_at")

  @@index([estado])
  @@map("testimonials")
}

// Páginas de servicios para el sitio web (Techo Propio, Crédito, etc.)
model PaginaServicio {
  id                String    @id @default(uuid())
  tipoServicio      TipoProyecto @map("tipo_servicio")
  titulo            String
  subtitulo         String?
  descripcionCorta  String?   @map("descripcion_corta")
  descripcionLarga  String?   @map("descripcion_larga")
  imagenBanner      String?   @map("imagen_banner")
  videoBanner       String?   @map("video_banner")
  requisitos        Json?
  beneficios        Json?
  pasos             Json?
  preguntas         Json?
  activo            Boolean   @default(true)
  ordenMostrar      Int       @default(0) @map("orden_mostrar")
  metaTitle         String?   @map("meta_title")
  metaDescription   String?   @map("meta_description")
  creadoEn          DateTime  @default(now()) @map("created_at")
  actualizadoEn     DateTime  @updatedAt @map("updated_at")

  @@unique([tipoServicio])
  @@index([activo])
  @@index([ordenMostrar])
  @@map("paginas_servicios")
}

// ==================== MODELOS PARA PORTAL DE CLIENTES ====================

// Contraseñas para acceso web de clientes
model ClientePassword {
  contactoId    String   @id @map("contacto_id")
  passwordWeb   String   @map("password_web")
  creadoEn      DateTime @default(now()) @map("created_at")
  actualizadoEn DateTime @updatedAt @map("updated_at")

  @@map("cliente_passwords")
}

// Documentos subidos por clientes
model ClienteDocumento {
  id              String   @id @default(uuid())
  contactoId      String   @map("contacto_id")
  nombreArchivo   String   @map("nombre_archivo")
  nombreOriginal  String   @map("nombre_original")
  rutaArchivo     String   @map("ruta_archivo")
  tipoDocumento   String   @map("tipo_documento")
  descripcion     String?
  tamanoBytes     Int      @map("tamano_bytes")
  mimeType        String   @map("mime_type")
  subidoEn        DateTime @default(now()) @map("subido_en")
  estado          String   @default("PENDIENTE")
  revisadoPor     String?  @map("revisado_por")
  revisadoEn      DateTime? @map("revisado_en")
  notas           String?

  @@index([contactoId])
  @@index([estado])
  @@index([subidoEn])
  @@map("cliente_documentos")
}

// Registro de accesos al portal
model ClienteAcceso {
  id             String   @id @default(uuid())
  contactoId     String   @map("contacto_id")
  fechaAcceso    DateTime @default(now()) @map("fecha_acceso")
  ipAddress      String   @map("ip_address")
  userAgent      String?  @map("user_agent")

  @@index([contactoId])
  @@index([fechaAcceso])
  @@map("cliente_accesos")
}

// Actividades del cliente en el portal
model ClienteActividad {
  id          String   @id @default(uuid())
  contactoId  String   @map("contacto_id")
  tipo        String
  descripcion String
  fecha       DateTime @default(now())
  metadata    Json?

  @@index([contactoId])
  @@index([fecha])
  @@map("cliente_actividades")
}
