generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id            String     @id @default(uuid())
  nombre        String
  email         String     @unique
  password      String
  rol           Rol        @default(AGENTE)
  avatar        String?
  telefono      String?
  activo        Boolean    @default(true)
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt
  contactos     Contacto[]

  @@map("usuarios")
}

model Contacto {
  id               String             @id @default(uuid())
  nombre           String
  apellido         String?
  correo           String?
  telefono         String?
  direccion        String?
  ciudad           String?
  dni              String?
  sexo             Sexo?
  fechaNacimiento  DateTime?
  tipo             TipoContacto       @default(CONTACTO)
  creadoEn         DateTime           @default(now())
  actualizadoEn    DateTime           @updatedAt
  usuarioId        String
  cargo            String?
  departamento     String?
  distrito         String?
  empresa          String?
  estadoLead       EstadoLead?
  fechaConversion  DateTime?
  fechaSeguimiento DateTime?
  fuente           String?
  intereses        String?            @db.Text
  notas            String?            @db.Text
  presupuesto      Decimal?           @db.Decimal(10, 2)
  prioridad        Prioridad          @default(MEDIA)
  probabilidad     Int?
  provincia        String?
  etiquetas        ContactoEtiqueta[]
  usuario          Usuario            @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId])
  @@index([tipo])
  @@index([correo])
  @@index([estadoLead])
  @@index([prioridad])
  @@map("contactos")
}

model Etiqueta {
  id            String             @id @default(uuid())
  nombre        String             @unique
  color         String
  descripcion   String?
  icono         String?
  activa        Boolean            @default(true)
  orden         Int                @default(0)
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  contactos     ContactoEtiqueta[]

  @@index([activa])
  @@map("etiquetas")
}

model ContactoEtiqueta {
  contactoId String
  etiquetaId String
  asignadoEn DateTime @default(now())
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)
  etiqueta   Etiqueta @relation(fields: [etiquetaId], references: [id], onDelete: Cascade)

  @@id([contactoId, etiquetaId])
  @@index([contactoId])
  @@index([etiquetaId])
  @@map("contacto_etiquetas")
}

enum Rol {
  ADMIN
  SUPERVISOR
  AGENTE
  ASISTENTE
}

enum Sexo {
  MASCULINO
  FEMENINO
  OTRO
}

enum TipoContacto {
  CONTACTO
  LEAD
  CLIENTE
}

enum EstadoLead {
  NUEVO
  CONTACTADO
  CALIFICADO
  NEGOCIACION
  PROPUESTA
  GANADO
  PERDIDO
  EN_ESPERA
}

enum Prioridad {
  BAJA
  MEDIA
  ALTA
  URGENTE
}
