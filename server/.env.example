# Base de datos
DATABASE_URL="mysql://usuario:password@host:puerto/nombre_bd"

# JWT - ⚠️ CAMBIA ESTO EN PRODUCCIÓN
JWT_SECRET="tu-secret-super-secreto-cambiar-en-produccion"
JWT_EXPIRES_IN="24h"

# Servidor
PORT=5000
NODE_ENV=development

# CORS - Origen del frontend
CORS_ORIGIN="http://localhost:3000"

# Bcrypt - Número de rounds para hash
BCRYPT_ROUNDS=10
